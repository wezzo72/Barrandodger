ings → Websites → Microphone, then select \\\"Allow\\\" for this website\",\"firefox\":\"Firefox\",\"firefoxSteps\":\"Click the lock icon in the address bar, click the arrow next to \\\"Blocked\\\" under Permissions, then select \\\"Allow\\\" for microphone\",\"promptMessage\":\"This feature needs microphone access to convert your speech to text. Click \\\"Try again\\\" and allow microphone access when your browser prompts you.\",\"cancel\":\"Cancel\",\"tryAgain\":\"Try Again\"},\"customerType\":{\"verticalTitle\":\"What industry are you in?\",\"verticalSubtitle\":\"Help us personalize your AI agent recommendations\",\"regionTitle\":\"What region are you in?\",\"regionSubtitle\":\"We'll show agents relevant to your region\",\"next\":\"Next\",\"back\":\"Back\",\"skip\":\"Skip\",\"getStarted\":\"Get Started\",\"save\":\"Save\",\"saving\":\"Saving...\",\"errorSaving\":\"Failed to save preferences. Please try again.\",\"otherVerticalPlaceholder\":\"Type your industry...\",\"verticals\":{\"legal\":\"Legal\",\"finance\":\"Finance\",\"healthcare\":\"Healthcare\",\"real_estate\":\"Real Estate\",\"education\":\"Education\",\"hr\":\"Human Resources\",\"marketing\":\"Marketing\",\"engineering\":\"Engineering\",\"other\":\"Other\"},\"regions\":{\"north_america\":\"North America\",\"europe\":\"Europe\",\"asia_pacific\":\"Asia Pacific\",\"middle_east_africa\":\"Middle East \u0026 Africa\",\"latin_america\":\"Latin America\"}}},\"sidebar\":{\"navigation\":{\"chatHistory\":\"Chat History\",\"files\":\"Files\",\"search\":\"Search\",\"customAgents\":\"Custom Agents\",\"sharedWithMe\":\"Shared with me\",\"sharedFiles\":\"Shared Files\",\"newChat\":\"New Chat\"},\"customAgentsPromo\":{\"title\":\"Custom Agents\",\"description\":\"Create custom agents to chat with AI about multiple files while maintaining context. Upgrade to Pro to unlock this feature.\"},\"teamsPromo\":{\"title\":\"AI Drive Business\",\"description\":\"Collaborate with your team, share files, folders and custom agents.