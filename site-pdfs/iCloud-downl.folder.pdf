isable {count, plural, one {# account} other {# accounts}}?\",\"confirmDisableMessage\":\"Disabled members can no longer sign in, run chats or scheduled chats, or use credits. You can re-enable them at any time without any data loss.\",\"confirmReEnableTitle\":\"Re-enable {count, plural, one {# account} other {# accounts}}?\",\"confirmReEnableMessage\":\"Re-enabled members get their account back exactly as it was. They will need to sign in again.\",\"success\":\"Updated {count, plural, one {# account} other {# accounts}} successfully\",\"partial\":\"Updated {success} of {total} accounts. Some updates failed.\",\"failed\":\"Failed to update accounts\",\"selectAll\":\"Select all disabled members\",\"selectMember\":\"Select {email}\",\"reEnableMember\":\"Re-enable {email}\",\"removeMember\":\"Remove {email} from the team\"}},\"apiManagement\":{\"title\":\"Manage API Keys\",\"warning\":\"Experimental API: This feature may undergo backward incompatible changes.\",\"viewDocumentation\":\"View API Documentation\",\"keys\":\"keys\",\"maximum\":\"maximum\",\"createNewKey\":\"Create New API Key\",\"adminOnly\":\"Only team admins can create API keys\",\"description\":\"Use these API keys to access the AI Drive API. Keep them secure and don't share them publicly.\",\"noKeys\":\"No API keys created yet. Click the 'Create New API Key' button to get started.\",\"table\":{\"apiKey\":\"API Key\",\"created\":\"Created\",\"actions\":\"Actions\"},\"buttons\":{\"cancel\":\"Cancel\",\"create\":\"Create\",\"delete\":\"Delete\",\"copyToClipboard\":\"Copy to clipboard\",\"viewFullKey\":\"View full key\",\"hideFullKey\":\"Hide full key\"},\"deleteModal\":{\"title\":\"Delete API Key?\"},\"toasts\":{\"copied\":\"Copied to clipboard\",\"keyCreated\":\"API key created\",\"keyCreateError\":\"Failed to create API key\",\"keyDeleted\":\"API key deleted\",\"keyDeleteError\":\"Failed to delete API key\"}},\"auditLogs\":{\"title\":\"Audit Logs\",\"subtitle\":\"Team activity history\",\"loadMore\":\"Load more\",\"showing\":\"Showing {start}-{end} of {total}\",\"streaming\":\"Loading...\",\"loadingMore\":\"{count} entries fetched\",\"loadingTitle\":\"Loading audit logs\",\"loadingDescription\":\"This may take a minute while we fetch your team's activity logs.\",\"emptyTitle\":\"No activity for this month\",\"emptyDescription\":\"No team activity was recorded during this period. Try selecting a different month.\",\"errorTitle\":\"Failed to load audit logs\",\"errorDescription\":\"Please try again later\",\"clearFilters\":\"Clear filters\",\"foundResults\":\"Found {count, plural, one {# result} other {# results}}\",\"forQuery\":\"for \\\"{query}\\\"\",\"inCategory\":\"in {category}\",\"noResultsTitle\":\"No results found\",\"noResultsDescription\":\"Try adjusting your search or filter to find what you're looking for.\",\"table\":{\"time\":\"Time\",\"activity\":\"Activity\",\"details\":\"Details\",\"userId\":\"User ID\",\"moreDetails\":\"+{count} more\"},\"searchPlaceholder\":\"Search by file name, user, path...\",\"categories\":{\"all\":\"All Activities\",\"files\":\"File Operations\",\"folders\":\"Folder Operations\",\"sharing\":\"Sharing\",\"chat\":\"Chat \u0026 AI\"},\"details\":{\"file\":\"File\",\"from\":\"From\",\"to\":\"To\",\"items\":\"Items\",\"newName\":\"New Name\",\"location\":\"Location\",\"path\":\"Path\",\"folder\":\"Folder\",\"folderName\":\"Folder Name\",\"sharedWith\":\"Shared with\",\"role\":\"Role\",\"agent\":\"Agent\",\"model\":\"Model\",\"publicLink\":\"Public link\",\"yourTeam\":\"Your team\",\"filesCount\":\"{count} files\",\"home\":\"Home\"}},\"usageNonPro\":{\"title\":\"Manage Usage\",\"info\":{\"message\":\"Free account: Upgrade to Pro for increased limits and features.\",\"link\":\"View Pro benefits\"},\"contents\":{\"title\":\"AI Drive Usage\",\"subtitle\":\"Monitor your usage and upgrade for higher limits.\",\"credits\":{\"title\":\"AI Drive Credits\",\"subtitle\":\"Used for Chat and OCR operations\",\"link\":\"Learn more about credits and usage\"},\"metadata\":{\"title\":\"AI-generated File Metadata\",\"subtitle\":\"Extracts key info including titles and descriptions\"},\"message\":\"Usage resets on the first day of each calendar month. Upgrade to Pro for higher limits and advanced features.\",\"button\":\"Upgrade to Pro\"}}},\"details\":{\"fields\":{\"name\":\"Name\",\"email\":\"Email\",\"accountType\":\"Account Type\",\"lastLogin\":\"Last Logged In\",\"memberSince\":\"Member Since\"},\"emailChange\":{\"button\":\"Change email\",\"title\":\"Change account email\",\"description\":\"Your files, teams, and sharing permissions stay with this account.\",\"newEmailLabel\":\"New email address\",\"newEmailPlaceholder\":\"name@example.com\",\"verificationNotice\":\"We will send a verification link to the new address. After opening it, please wait until the account update finishes before signing in with the new email. Most updates finish within a few minutes, but allow up to one hour.\",\"sendVerification\":\"Send verification\",\"starting\":\"Starting...\",\"cancel\":\"Cancel\",\"managedDescription\":\"This email is managed by your organization. Contact your administrator to change it.\",\"signInAgain\":\"Sign out and sign in with the new email\",\"errors\":{\"load\":\"Email-change details could not be loaded.\",\"reauth\":\"Sign in again to confirm this change.\",\"accountMismatch\":\"The sign-in completed with a different account.\",\"start\":\"The email change could not be started.\",\"verificationUnknown\":\"We couldn't confirm whether the verification email was sent. Check the new inbox. If it does not arrive, try again after this request expires.\"},\"states\":{\"requested\":\"Preparing email verification...\",\"verification_sent\":\"Verification sent. Open the link in your new email, then wait for the account update to finish before signing in. Most updates finish within a few minutes, but allow up to one hour.\",\"auth_email_changed\":\"Email verified. Finishing your account update...\",\"billing_reconciling\":\"Email verified. Billing details are syncing...\",\"failed_retryable\":\"The account update is still syncing and will retry automatically.\",\"completed\":\"Your email was changed. Sign in again with the new address.\",\"needs_review\":\"The email changed, but support must finish the account update.\",\"expired\":\"The verification link expired. Start a new email change.\",\"canceled\":\"The email change was canceled.\"},\"callback\":{\"finishingTitle\":\"Finishing your email change\",\"finishing\":\"Keep this page open while we sync your account and sign-in details. Most updates finish within a few minutes, but allow up to one hour. Contact support if it is still not ready after that.\",\"completedTitle\":\"Email changed\",\"completed\":\"Your files, teams, and shared access remain on the same account.\",\"signInTitle\":\"Sign in with your new email\",\"signIn\":\"The address was verified. We're finishing your account update. Most updates complete within a few minutes. If sign-in does not work yet, wait and try again. Allow up to one hour.\",\"errorTitle\":\"Email change needs attention\",\"failed\":\"The email change could not be completed automatically.\",\"invalid\":\"This email-change link is not associated with your signed-in account.\",\"notVerified\":\"The new email has not been verified yet.\",\"backToAccount\":\"Back to account\"}},\"eapLabel\":\"AI Drive EAP\",\"upgrade\":{\"freeToPro\":{\"title\":\"Upgrade to Pro\",\"description\":\"Access all AI models (OpenAI Models, Claude, Gemini), 50,000 credits/month, custom AI agents, and chat with folders.\",\"button\":\"Upgrade to Pro\"},\"proToBusiness\":{\"title\":\"Upgrade to Business\",\"description\":\"Get 6x credits (300,000/month), share files \u0026 agents, priority support, advanced security, and pre-built AI agents.\",\"button\":\"Upgrade to Business\"}},\"customerProfile\":{\"title\":\"Customer Profile\",\"vertical\":\"Industry\",\"region\":\"Region\",\"edit\":\"Edit\",\"setup\":\"Set up your profile\",\"notSet\":\"Not set\"},\"externalProfile\":{\"title\":\"Microsoft AD Profile\",\"description\":\"Synced from your organization's Microsoft Entra directory.\",\"source\":\"External integration\",\"lastSynced\":\"Last synced {date}\",\"fields\":{\"name\":\"Name\",\"title\":\"Title\",\"department\":\"Department\",\"office\":\"Office\",\"company\":\"Company\",\"email\":\"Email\",\"phone\":\"Phone\"}},\"deleteAccount\":{\"title\":\"Delete account\",\"description\":\"Deleting your account will permanently erase your files, prompts, and data, and this action cannot be undone. \u003cclickHere\u003e{clickHere}\u003c/clickHere\u003e to proceed with the deletion.\",\"guide\":{\"intro\":\"Cancelling a plan, deleting a team, and deleting your account are separate actions. Choose the one you need:\",\"introWithoutTeam\":\"Cancelling a plan and deleting your account are separate actions. Choose the one you need:\",\"cancelSubscription\":\"\u003cstrong\u003eCancel a subscription:\u003c/strong\u003e under Manage subscription on this page, select Cancel on your plan, choose Continue with cancellation if prompted, then confirm. Cancel any credit add-ons first. Your account and files stay. A paid plan remains active until the end of the current billing period; a trial ends immediately. If cancellation is unavailable, contact support.\",\"deleteTeam\":\"\u003cstrong\u003eDelete a team:\u003c/strong\u003e team admins can open \u003cteamsLink\u003eManage Your Team\u003c/teamsLink\u003e and choose \\\"Delete your team\\\". Members lose team access, and files shared with the team stop being shared but are not deleted. The team subscription is not cancelled automatically, so cancel it separately.\",\"leaveTeam\":\"\u003cstrong\u003eLeave a team:\u003c/strong\u003e ask a team admin to remove you. If you are an admin, ask another admin to change your role to Member first. Your account and your own files stay.\",\"deleteAccount\":\"\u003cstrong\u003eDelete your account:\u003c/strong\u003e besides erasing your data, this immediately cancels subscriptions billed to you and removes you from your teams.\",\"deleteAccountTeamAdmin\":\"If you are a team's only active admin, another active member is promoted to admin. If no other member is active, re-enable a member or delete the team first. A team plan billed to you is cancelled too, so the team loses its plan.\",\"contact\":\"Not sure which option is right for you? Contact \u003cemail\u003e{email}\u003c/email\u003e before deleting anything.\"}},\"creditUsage\":{\"noData\":\"No data found !!\",\"monthlySystem\":{\"title\":\"Monthly Credit System\",\"description\":\"Free accounts get 2K credits per month. Pro accounts get 50K credits, with option to buy additional 50K credit packs. Team accounts: Credits are shared across your entire team. Usage resets on the first day of each month. Unused credits do not roll over.\"}},\"costCenters\":{\"overview\":{\"unavailableMessage\":\"Cost centers are only available for yearly pools teams.\",\"description\":\"Manage AI credit allocation across departments, projects, and offices.\",\"usageReportTitle\":\"Usage report\",\"transferButton\":\"Transfer Credits\",\"createButton\":\"Create Cost Center\",\"searchPlaceholder\":\"Search cost centers...\",\"filterStatusLabel\":\"Status\",\"filterBalanceLabel\":\"Balance\",\"statusActive\":\"Active\",\"statusAll\":\"All statuses\",\"balanceAll\":\"All balances\",\"balanceAvailable\":\"Credits available\",\"balanceExhausted\":\"No credits available\",\"balanceFilterHelp\":\"Filters by remaining active pool credits: available means greater than zero.\",\"balanceFilterPostPaidHelp\":\"Filters by unallocated credits available to assign: available means greater than zero.\",\"clearFilters\":\"Clear filters\",\"showingResults\":\"Showing {shown} of {total} cost centers\",\"pageRange\":\"{start}–{end} of {total}\",\"rowsPerPage\":\"Rows per page\",\"previousPage\":\"Previous page\",\"nextPage\":\"Next page\",\"listLabel\"