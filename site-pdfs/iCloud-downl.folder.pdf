\"updating\":\"Updating Agent...\",\"update\":\"Update Agent\"},\"labels\":{\"agent\":\"Agent\",\"agents\":\"Agents\"},\"duplicateAgent\":{\"title\":\"Custom Agent Already Exists\",\"description\":\"A custom agent named {agentName} already exists. Replacing it will overwrite the existing custom agent permanently. Do you want to continue?\",\"cancel\":\"Cancel\",\"replace\":\"Replace Custom Agent\"},\"mcpConnectors\":{\"label\":\"MCP Connectors\",\"description\":\"Select connectors to automatically enable when chatting with this agent\"}},\"excelViewer\":{\"exportOptions\":{\"excel\":\"Excel\",\"csv\":\"CSV\",\"csvWarning\":{\"title\":\"CSV Warning\",\"message\":\"All the formatting will be lost while saving as CSV and only the first sheet will be exported. Switch back to Excel to save all sheets with formatting!\"}}},\"helpMenu\":{\"tutorialVideos\":{\"title\":\"Tutorial Videos\",\"description\":\"Learn how to use our platform\"},\"contactSupport\":{\"title\":\"Contact Support\",\"description\":\"Get help from our team\"},\"credits\":{\"title\":\"Credits\",\"description\":\"View your credits and usage\"},\"privacyPolicy\":{\"title\":\"Privacy Policy\",\"description\":\"Read our privacy policy\"},\"dataProcessingAddendum\":{\"title\":\"Data Processing Addendum\",\"description\":\"Read our data processing addendum\"},\"copyrightDisputePolicy\":{\"title\":\"Copyright Dispute Policy\",\"description\":\"Read our copyright dispute (DMCA) policy\"}},\"actionChip\":{\"badge\":{\"selected\":\"selected\"},\"upgrade\":{\"teamsShare\":\"Upgrade to Teams to share files\"},\"tooltips\":{\"errors\":{\"mixedSharedStatus\":\"Cannot perform actions on mixed shared and non-shared items\",\"tooManyFilesForCopy\":\"Cannot copy more than 5 files to ChatGPT\",\"tooManyFilesForDownload\":\"Cannot download more than 50 files at once\",\"tooManyFilesForRename\":\"Cannot rename more than 50 files at once\",\"cannotShareMultiple\":\"Cannot share multiple files - only single files can be shared\",\"cannotShareShared\":\"Cannot share items that are already shared with you\",\"cannotShareItems\":\"Cannot share these items\"},\"actions\":{\"chat\":{\"single\":\"Start a conversation with this item\",\"multiple\":\"Start a conversation with all {count} items\"},\"copy\":{\"single\":\"Copy this item to ChatGPT prompt\",\"multiple\":\"Copy {count} items to ChatGPT prompt\"},\"download\":{\"single\":\"Download this item\",\"multiple\":\"Download {count} items\"},\"ocr\":{\"single\":\"Run OCR on this file\",\"multiple\":\"Run OCR on {count} files\"},\"duplicate\":{\"singleFile\":\"Make a copy\",\"singleFolder\":\"Duplicate folder\",\"multiple\":\"Duplicate {count} items\"},\"rename\":{\"single\":\"Rename this item\",\"multiple\":\"Rename {count} items\"},\"move\":{\"single\":\"Move this item to another folder\",\"multiple\":\"Move {count} items to another folder\"},\"share\":{\"single\":\"Share this item with others\",\"multiple\":\"Share {count} items with others\"},\"delete\":{\"single\":\"Delete this item permanently\",\"multiple\":\"Delete {count} items permanently\"},\"clear\":\"Clear selection ({count} items)\"}}},\"customAgentsViewer\":{\"myAgents\":\"My Agents\",\"sharedWithMe\":\"Shared with me\",\"createButton\":\"Create\",\"loading\":\"Loading your agents\",\"emptyState\":{\"title\":\"Looking a little empty here\",\"description\":\"Try creating a new Agent\"},\"placeholder\":{\"shortDescription\":\"Add a short description\"}},\"emailTrigger\":{\"title\":\"Email Trigger\",\"description\":\"Allow this agent to be triggered by emails with attachments\",\"upgradeToTeams\":\"Upgrade to Business to access this feature\",\"infoTooltip\":\"Email your custom agent with your query and files to get AI responses directly in your chat.\",\"emailAddressHeader\":\"Your dedicated agent email address:\",\"howItWorksHeader\":\"How email triggering works:\",\"steps\":{\"step1\":\"You have a dedicated custom agent email address.\",\"step2\":\"Email your custom agent with your query in the body and attach any relevant files you want the agent to process.\",\"step3\":\"The agent receives your email, analyzes your query, and processes any attachments according to its configuration.\",\"step4\":\"The agent's response appears as a new unread chat conversation in your AI Drive.\",\"step5\":\"View the agent's response and continue the conversation if needed.\"},\"tip\":\"Tip: This email address is unique to this custom agent and uses its configured settings.\",\"copyEmailAriaLabel\":\"Copy email address\",\"toast\":{\"settingsUpdated\":\"Email settings updated successfully\",\"updateFailed\":\"Failed to update email settings\",\"emailCopied\":\"Email address copied to clipboard\",\"copyFailed\":\"Failed to copy email address\",\"agentNameRequired\":\"Please enter an agent name before enabling email trigger\"},\"agentNameTooLong\":\"Agent name exceeds 100 characters. Provide a smaller name to access email triggers.\",\"emailPrefixHelper\":\"You can edit using letters, numbers \u0026 periods\",\"copyWarning\":\"Sorry, only letters (a-z), numbers (0-9), periods (.), and underscores (_) are allowed.\",\"lengthExceeded\":\"Sorry, the prefix must be 50 characters or less.\",\"generatingEmail\":\"Generating your email address...\",\"emailModel\":{\"label\":\"Email Model\",\"selectLabel\":\"Select email model\",\"noModelsSelected\":\"No models selected - please select AI models above\"},\"warnings\":{\"keepPrivate\":\" Keep this email private - Don't share this address as it will trigger your custom agent for anyone who emails it.\",\"accessRestrictions\":\" Access restrictions coming soon - We're implementing controls to limit who can interact with your agent via email.\"},\"accessControl\":{\"title\":\"Email Access Control\",\"configureTitle\":\"Configure Email Access for \\\"{agentName}\\\"\",\"configureDescription\":\"Control who can send emails to this agent. The owner email is always allowed.\",\"loadingSettings\":\"Loading settings...\",\"saveChanges\":\"Save Changes\",\"saving\":\"Saving...\",\"cancel\":\"Cancel\",\"configureAccess\":\"Configure Access\",\"configureAccessTooltip\":\"Configure who can access your agent via emails\",\"errors\":{\"loadFailed\":\"Failed to load settings\",\"saveFailed\":\"Failed to save settings\"},\"whitelist\":{\"title\":\"Email Whitelist\",\"description\":\"Only emails in this list can send messages to your agent\",\"owner\":\"Owner\",\"addButton\":\"Add\",\"placeholder\":\"Enter email address\",\"validation\":{\"required\":\"Email address is required\",\"invalid\":\"Please enter a valid email address\",\"ownerExists\":\"Owner email is automatically included\",\"alreadyExists\":\"Email already exists in the list\",\"invalidCharacters\":\"Sorry, only letters (a-z), numbers (0-9), periods (.), underscores (_), and @ are allowed.\",\"emailTooLong\":\"Email address is getting long\",\"emailMaxLength\":\"Email address is too long (max {maxLength} characters)\",\"limitReached\":\"You have reached the maximum limit of 20 whitelisted emails\"}},\"teamAccess\":{\"title\":\"Team Member Access\",\"description\":\"Allow all team members to email this agent\",\"tooltip\":\"Requires team subscription\"},\"forwardedAccess\":{\"title\":\"Auto-Forwarded Email Access\",\"description\":\"Allow mail auto-forwarded from your inbox to reach this agent\",\"setupNote\":\"Setting up auto-forwarding? Your mail provider first sends a confirmation email — add its address (for example forwarding-noreply@google.com) to the whitelist above. Once it passes authentication, the confirmation link appears in your agent chat for you to click and approve. Auto-forwarding is active from then on.\"},\"summary\":{\"title\":\"Access Summary\",\"description\":\"Current configuration overview\",\"accessLevel\":\"Access Level: {level}\",\"authorized\":\"{count} authorized\",\"owner\":\"Owner: {email}\",\"whitelisted\":\"Whitelisted: {count} email{count, plural, one{} other{s}}\",\"teamEnabled\":\"Team members: Enabled\",\"privateOnly\":\"Only the owner can currently send emails to this agent. Add emails to the whitelist or enable team access to allow others to interact with your agent.\",\"forwardedEnabled\":\"Auto-forwarded email: Enabled\"}},\"unattendedUploads\":{\"title\":\"Let this agent send files on its own\",\"description\":\"Applies only when the agent runs from an email or a schedule. In a normal chat you still approve each upload.\",\"grantTitle\":\"Permission {index}\",\"sentence\":\"When running on its own, this agent may send files from {folders} to {sites}.\",\"sentenceNoFolders\":\"(no folders chosen yet)\",\"sentenceNoSites\":\"(no websites yet)\",\"foldersLabel\":\"From these folders\",\"foldersPlaceholder\":\"Type a folder or file path, e.g. Reports/2026/\",\"foldersHint\":\"Choosing a folder allows every file inside it. To allow a single file, type its path instead.\",\"chooseFolder\":\"Choose folder\",\"typePath\":\"or type a path\",\"folderPickerTitle\":\"Choose a folder\",\"folderPickerDescription\":\"The agent may send any file inside the folder you choose, including its subfolders.\",\"folderPickerSelected\":\"Selected: {path}\",\"folderPickerPickOne\":\"Pick a folder from the list.\",\"folderPickerConfirm\":\"Use this folder\",\"folderPickerCancel\":\"Cancel\",\"sitesLabel\":\"To these websites\",\"sitesPlaceholder\":\"Paste the website address, e.g. vendor.example.com\",\"sitesHint\":\"You can paste the full address of the page; only the website name is kept.\",\"add\":\"Add\",\"addGrant\":\"Add permission\",\"removeGrant\":\"Remove this permission\",\"removeItem\":\"Remove {value}\",\"declaredInInstructions\":\"Also allowed by the agent's instructions\",\"declaredInInstructionsHint\":\"These come from the agent's instructions and can only be changed there.\",\"incompleteGrant\":\"Choose at least one folder and add at least one website.\",\"unsavedNote\":\"Saved when you save the agent.\",\"saveError\":\"Couldn't save the file-sending permissions\",\"loadError\":\"Couldn't load this agent's settings\",\"invalidFolder\":\"Enter a path inside your AI Drive, like Reports/2026/. It can't start with / or ~, or contain \\\"..\\\".\",\"invalidHost\":\"Enter a website address like vendor.example.com\",\"duplicate\":\"Already in the list\",\"limitReached\":\"You can add up to {max}\",\"noGrants\":\"This agent can't send files on its own yet. Add a folder and a website to allow it.\"},\"securityModal\":{\"title\":\"Email Agent Security\",\"subtitle\":\"Your AI agent will follow instructions it receives via email.\",\"howItWorks\":\"Here's how it works:\",\"bullet1\":\"Emails and attachments can contain instructions for your agent\",\"bullet2\":\"Your agent will process these instructions automatically\",\"bullet3\":\"Malicious or unexpected instructions could cause unwanted actions\",\"bestPractice\":\"Best Practice:\",\"bestPracticeText\":\"Only share your agent email with trusted senders. Don't forward suspicious messages or attachments to your agent.\",\"acknowledgment\":\"I understand that my agent will follow email instructions, and I'll only share this email address with trusted senders.\",\"notNow\":\"Not Now\",\"continue\":\"Got It, Continue\",\"dontShowAgain\":\"Don't show this again for any agent\"}},\"renameChatModal\":{\"title\":\"Rename Chat\",\"form\":{\"placeholder\":\"Enter chat name\"},\"buttons\":{\"cancel\":\"Cancel\",\"rename\":\"Rename\",\"renaming\":\"Renaming...\"},\"sanitizedWarning\":\"Special characters have been replaced or removed\",\"youTyped\":\"You typed:\",\"validation\":{\"noChange\":\"Please enter a different name\"},\"error\":{\"failed\":\"Failed to rename chat\"},\"success\":{\"renamed\":\"Chat renamed successfully\"}},\"agentChatInfo\":{\"infoBannerTitle\":\" Please use @ to add files.\",\"infoBannerTitleAgent\":\" Please use @ to add files for agent.\",\"learnMore\":\"Learn More\",\"modal\":{\"title\":\"Including Files in Chat\",\"subtitle\":\"Easily include files in your conversations.\",\"walkthrough\":{\"first\":\"Type @ in the chat\",\"second\":\"Start typing the file name\",\"third\":\"Select the file from the dropdown\"}},\"overlayInfo\":{\"info\":\"Drag more files or submit prompt to start conversation\"},\"dragFilesToChat\":\"Drag files to chat\",\"dragToView\":\"Drag to view the file\"},\"emptyChat\":{\"addFilesTitle\":\"Add files to start chatting\",\"chatWithFilesTitle\":\"Chat with your files\",\"addFilesDescription\":\"Drag and drop your files here, or click the chat icon next to file name to begin.\",\"chatWithFilesDescription\":\"Ask questions about your documents or get help organizing your workspace.\",\"quickActions\":{\"searchTitle\":\"Search files\",\"searchDesc\":\"Find content across directories\",\"analyzeTitle\":\"Analyze docs\",\"analyzeDesc\":\"Get insights from your files\",\"organizeTitle\":\"Organize\",\"organizeDesc\":\"Structure your content\"},\"tryAsking\":\"Try asking\",\"suggestions\":[\"What's in my documents folder\",\"Help me organize these files\",\"Summarize my recent PDFs\"],\"chatMessages\":{\"chattingWithAgent\":\"You're now chatting with {agentName}, a custom agent designed to help with specific tasks.\",\"askToGetStarted\":\"Ask anything to get started!\"}},\"customMcpConnectors\":{\"imanageDownloads\":\"Import documents from iManage\",\"title\":\"Custom connectors\",\"subtitle\":\"Connect any remote MCP server by URL. Tools from a custom server run with your credentials — only add servers you trust.\",\"addConnector\":\"Add custom connector\",\"connectServer\":\"Connect a server\",\"emptyTitle\":\"No custom connectors yet\",\"emptySubtitle\":\"Add an MCP server URL to make its tools available in chat.\",\"statusConnected\":\"Connected\",\"statusError\":\"Error\",\"statusAuthRequired\":\"Sign-in required\",\"statusUnknown\":\"Unknown\",\"authModeOauth2\":\"OAuth\",\"authModeApiKey\":\"API key\",\"authModeNone\":\"No authentication\",\"authHintOauth2\":\"You will be redirected to the server to sign in.\",\"authHintApiKey\":\"Sent as a request header on every call. Stored encrypted.\",\"authHintNone\":\"For public servers that require no credentials.\",\"openWithAgent\":\"Open with agent\",\"sanityCheckPrompt\":\"I just added the \\\"{name}\\\" MCP connector. Please do some sanity checks on its tools, but do not perform any destructive actions.\",\"reconnect\":\"Reconnect\",\"testManageTools\":\"Test \u0026 manage tools\",\"edit\":\"Edit\",\"removeAria\":\"Remove {name}\",\"waitingForSaves\":\"Waiting for permission changes to save…\",\"toolPermissions\":\"Tool permissions\",\"serverCapabilities\":\"Discovered capabilities\",\"resources\":\"Resources\",\"resourceTemplates\":\"Resource templates\",\"prompts\":\"Prompts\",\"noCapabilities\":\"The server connected but did not advertise tools, resources, resource templates, or prompts.\",\"advertisedCapabilitiesNote\":\"Resources, resource templates, and prompts are advertised by the server. AI Drive lists them for visibility, but agent chat does not use them yet.\",\"dismissTestResults\":\"Dismiss test results\",\"untestedNote\":\"Until a connector is tested, every tool asks for approval. Destructive tools stay blocked unless you allow them.\",\"showMore\":\"Show more\",\"showLess\":\"Show less\",\"saved\":\"Saved\",\"policyAllow\":\"Allow\",\"policyAsk\":\"Ask first\",\"policyDeny\":\"Block\",\"foundTools\":\"{count, plural, one {Found # tool} other {Found # tools}}\",\"foundCapabilities\":\"Found {toolCount} tools, {resourceCount} resources, {resourceTemplateCount} resource templates, and {promptCount} prompts\",\"testFailed\":\"Connection test failed\",\"reconnectFailed\":\"Failed to reconnect\",\"removedConnector\":\"Removed {name}\",\"removeFailed\":\"Failed to remove\",\"policyUpdateFailed\":\"Failed to update tool policy\",\"deleteTitle\":\"Remove custom connector?\",\"deleteDescription\":\"This permanently removes {name}, its stored credentials, and its tool permissions. This action cannot be undone.\",\"deleteFallbackName\":\"this connector\",\"keepConnector\":\"Keep connector\",\"removeConnector\":\"Remove connector\",\"editTitle\":\"Edit connector\",\"createTitle\":\"Add custom connector\",\"editDescription\":\"Update the connector details. Leave the credential blank to keep the current one.\",\"createDescription\":\"Connect a remote MCP server so its tools are available in chat.\",\"nameLabel\":\"Name\",\"namePlaceholder\":\"My MCP server\",\"serverUrl\":\"Server URL\",\"invalidUrl\":\"Enter a valid https:// URL.\",\"urlChangeWarning\":\"Changing the URL clears the saved credentials and tool permissions for this connector.\",\"authentication\":\"Authentication\",\"authFixed\":\"Authentication type is fixed after creation. You can rotate its credentials below.\",\"oauthClientRequired\":\"Pre-registered OAuth client (required for Slack)\",\"oauthClientOptional\":\"Pre-registered OAuth client (optional)\",\"oauthClientHint\":\"Leave blank for servers with dynamic client registration. Enter the registered client for servers such as Slack.\",\"slackNote\":\"Slack requires both a client ID and client secret from an MCP-enabled Slack app, plus the user scopes needed by its tools.\",\"redirectUri\":\"OAuth redirect URI\",\"redirectUriHint\":\"Register this exact URI in the provider application.\",\"clientId\":\"Client ID\",\"clientSecret\":\"Client secret\",\"keepCurrentPlaceholder\":\"Leave blank to keep current\",\"scopes\":\"Scopes\",\"scopesOptional\":\"Scopes (optional)\",\"scopesHint\":\"Space-separated. Request only the permissions you need.\",\"headerLabel\":\"Header\",\"valueLabel\":\"Value\",\"newValueOptional\":\"New value (optional)\",\"schemeHint\":\"Include the scheme, e.g.\",\"hideValue\":\"Hide value\",\"showValue\":\"Show value\",\"trustTitle\":\"I trust this server\",\"trustDescription\":\"Its tools can read and act on your data using your account. Only connect servers you control or trust.\",\"cancel\":\"Cancel\",\"saveChanges\":\"Save changes\",\"connect\":\"Connect\",\"genericError\":\"Something went wrong\",\"connectorUpdated\":\"Connector updated\",\"connectorAdded\":\"Connector added\",\"groupReadOnly\":\"Read-only tools\",\"groupNeedsApproval\":\"Needs approval\",\"groupDestructive\":\"Destructive tools\",\"setAllInGroup\":\"Set all\",\"chipSanityCheck\":\"Run a sanity check\",\"chipExplore\":\"What can it do?\",\"explorePrompt\":\"What can the \\\"{name}\\\" MCP connector do? Summarize its tools and suggest a few example tasks. Do not perform any destructive actions.\",\"teamPolicyWaiting\":\"Custom MCP servers become available after your team admin enables them.\",\"teamPolicyWaitingAdmin\":\"Custom MCP is turned off for your team — enable it in the panel above.\",\"noEligibleServers\":\"Your admin hasn't granted you any MCP servers yet.\",\"noEligibleServersAdmin\":\"No allowed servers yet — add one in “Custom MCP servers for your team” above, then connect to it here.\",\"pickServerTitle\":\"Add a team-approved server\",\"pickServerDescription\":\"Choose one of the MCP servers your team admin has approved.\",\"serverUrlLocked\":\"The server URL is managed by your team admin.\",\"notTestedNote\":\"Not tested yet — every tool will require approval until you run Test \u0026 manage tools.\",\"blockedByTeamNote\":\"Blocked by your team's MCP policy — the server isn't on the allowlist or your team access changed. Ask your admin, or delete the connector.\",\"denyFloorTooltip\":\"Destructive tools always require approval\",\"teamAccessError\":\"We couldn't verify your team's MCP policy. Adding connectors is paused — refresh the page to retry.\",\"addCustomConnector\":\"Add custom connector\",\"catalogBadge\":\"Catalog\",\"catalogTitle\":\"MCP server catalog\",\"catalogDescription\":\"Hand-vetted remote MCP servers you can add in one click.\",\"catalogSearchPlaceholder\":\"Search servers\",\"catalogAllCategories\":\"All categories\",\"catalogEmpty\":\"No servers match your search.\",\"catalogLoadError\":\"The catalog could not be loaded. Please try again.\",\"catalogUnavailable\":\"Your team policy could not be verified, so the catalog is unavailable right now. Please try again.\",\"catalogDisabled\":\"The catalog is currently disabled.\",\"catalogBlocked\":\"Your team admin has not enabled custom MCP servers yet.\",\"catalogBack\":\"Back to catalog\",\"catalogAddServer\":\"Add\",\"catalogPublisher\":\"Made by\",\"catalogDocs\":\"Documentation\",\"catalogPrivacy\":\"Privacy policy\",\"catalogAddedDate\":\"Added\",\"catalogVerifiedDate\":\"Last verified\",\"catalogTeamApproved\":\"Team approved\",\"catalogCuratedNote\":\"AI Drive verified this server's connection flow, but its tools are operated by the publisher. Your tool permissions still apply to every call.\",\"trustTitleCatalog\":\"Connect this catalog server?\",\"trustDescriptionCatalog\":\"This server was vetted by AI Drive. Its tools are operated by the publisher, and your per-tool permissions still apply.\",\"serverUrlLockedCatalog\":\"This server comes from the AI Drive catalog, so its URL cannot be changed.\",\"scopeCatalogDefault\":\"Prefilled with the catalog's verified default. Edit only if you know this server needs something different.\",\"catalogAddCustomHint\":\"Connect any remote MCP server by URL.\",\"authDefaultCatalog\":\"Preselected to this server's recommended method — you can choose another.\",\"catalogAlreadyAdded\":\"Added\",\"catalogReviewAdded\":\"Review entry\",\"connectorAlreadyExists\":\"\\\"{name}\\\" is already set up below — no need to add it again.\",\"managedSlackTestRequired\":\"Run “Test \u0026 manage tools” to enable Slack tools before using this connection in chat, scheduled agents, or email-triggered agents.\",\"managedSlackConsent\":\"Members authorize their own Slack account. App credentials are managed centrally.\",\"managedSlackWorkspace\":\"Approved workspace: {workspace}\",\"managedSlackAccount\":\"Connected Slack account: {account}\",\"managedSlackUnavailable\":\"Slack is unavailable. Contact your administrator.\",\"managedSlackBackground\":\"Scheduled and email-triggered agents can read permitted Slack data using the agent owner’s connection. Sending requires interactive approval and is unavailable for unattended runs.\",\"slackCapabilities\":{\"public_read\":\"Public-channel read and search\",\"private_read\":\"Private-channel read\",\"direct_messages\":\"Direct messages\",\"files_read\":\"Read files\",\"send_messages\":\"Send messages (approval required)\"},\"completeToContinue\":\"To continue, complete the following:\",\"requiredField\":\"Enter {field}.\",\"slackScopesRequired\":\"Enter Slack scopes. The example text is a placeholder; use scopes configured in your Slack app.\",\"trustRequired\":\"Check the server trust confirmation.\",\"fingerprintNameOnlyTitle\":\"Match tools by name only (not secure)\",\"fingerprintNameOnlyDescription\":\"Skips the exact-definition check, so a changed or swapped tool keeps its permissions. Only for servers you fully trust whose tool definitions change between requests.\"},\"customMcpTeamPolicy\":{\"slackCapabilitiesRequired\":\"Select at least one Slack permission before saving.\",\"slackUnavailable\":\"Slack is unavailable. Contact your administrator.\",\"slackCapabilitiesLabel\":\"Slack permissions\",\"slackCapabilitiesHint\":\"Only selected permissions are allowed. Slack’s own access rules still apply.\",\"slackWorkspace\":\"Approved workspace: {workspace}\",\"slackBackgroundHint\":\"Scheduled and email-triggered agents can read permitted Slack data using the agent owner’s connection. Sending requires interactive approval and is unavailable for unattended runs.\",\"slackCapabilities\":{\"public_read\":\"Public-channel read and search\",\"private_read\":\"Private-channel read\",\"direct_messages\":\"Direct messages\",\"files_read\":\"Read files\",\"send_messages\":\"Send messages (approval required)\"},\"title\":\"Custom MCP servers for your team\",\"subtitle\":\"Control whether members can connect custom MCP servers and which servers they may use.\",\"enableLabel\":\"Allow custom MCP servers\",\"enableHint\":\"When off, members cannot connect or use custom MCP servers.\",\"serversTitle\":\"Allowed servers\",\"addServer\":\"Add server\",\"addServerTitle\":\"Add allowed server\",\"editServerTitle\":\"Edit allowed server\",\"serverDialogDescription\":\"Members will be able to connect this MCP server with their own credentials.\",\"addServerConfirm\":\"Add server\",\"applyChanges\":\"Apply changes\",\"editServerAria\":\"Edit {name}\",\"removeServerAria\":\"Remove {name}\",\"noServers\":\"No servers allowed yet. Add one so members can connect it.\",\"nameLabel\":\"Name\",\"namePlaceholder\":\"My MCP server\",\"urlLabel\":\"Server URL\",\"invalidUrl\":\"Enter a valid https:// URL.\",\"notesLabel\":\"Notes (optional)\",\"notesPlaceholder\":\"What this server is for\",\"visibilityLabel\":\"Who can use this server\",\"visibility\":{\"everyone\":{\"label\":\"Everyone on the team\",\"description\":\"Every member can connect this server.\"},\"selected\":{\"label\":\"Only selected groups and members\",\"description\":\"Limit this server to specific user groups or members.\"}},\"visibilityEveryoneBadge\":\"Everyone\",\"visibilitySelectedBadge\":\"{groups, plural, one {# group} other {# groups}}, {members, plural, one {# member} other {# members}}\",\"selectedEmptyHint\":\"Pick at least one group or member, or switch back to everyone.\",\"groupsLabel\":\"User groups\",\"searchGroups\":\"Search groups\",\"noGroups\":\"No user groups yet.\",\"noMatches\":\"No matches.\",\"groupMemberCount\":\"{count, plural, one {# member} other {# members}}\",\"membersLabel\":\"Members\",\"searchMembers\":\"Search members\",\"removeGroupAria\":\"Remove group {name}\",\"removeMemberAria\":\"Remove member {name}\",\"cancel\":\"Cancel\",\"saving\":\"Saving…\",\"saveError\":\"Failed to save the custom MCP policy.\",\"conflictError\":\"The policy was changed by someone else. It has been refreshed — please redo your edits.\",\"loadError\":\"Unable to load the custom MCP policy.\",\"retry\":\"Retry\",\"serverCapHint\":\"The allowlist is limited to 50 servers. Remove an entry to add another.\",\"catalogAlreadyListed\":\"\\\"{name}\\\" already covers this server — editing the existing entry.\",\"catalogUrlLocked\":\"Imported from the AI Drive catalog; the URL is locked to the vetted value.\",\"catalogSourceBadge\":\"Catalog\",\"addCustomServer\":\"Add a custom server\",\"addCustomServerHint\":\"Allow a server that is not in the catalog by entering its URL.\",\"serversInstantSaveHint\":\"Members can only connect the servers listed here. Changes save automatically.\",\"policyEnabled\":\"Custom MCP servers are now allowed for your team.\",\"policyDisabled\":\"Custom MCP servers are now blocked for your team.\",\"serverAdded\":\"\\\"{name}\\\" added to the allowlist.\",\"serverUpdated\":\"\\\"{name}\\\" updated.\",\"serverRemoved\":\"\\\"{name}\\\" removed from the allowlist.\",\"connectNow\":\"Connect it\",\"removeServerTitle\":\"Remove this server?\",\"removeServerDescription\":\"Members lose access to \\\"{name}\\\" right away, and their existing connectors to it stop working. This takes effect immediately.\",\"removeServerConfirm\":\"Remove server\",\"removing\":\"Removing…\",\"conflictReloadFailed\":\"The policy was changed by someone else and could not be reloaded. Retry to load the latest version.\",\"serverRemovedElsewhere\":\"\\\"{name}\\\" was removed by another admin, so your changes were not saved.\"},\"integrations\":{\"slack\":{\"title\":\"Slack Bot Integration\",\"integrationDesc\":\"With this integration, you'll be able to:\",\"desc\":\"Connect your AI Drive to Slack for seamless document access and AI assistance directly in your workspace.\",\"dm\":\"Direct message with the AI Drive agent via Slack\",\"dmDetails\":\"Send messages directly to the AI agent to get instant responses\",\"invoke\":\"Invoke the AI Drive agent to read your files\",\"in