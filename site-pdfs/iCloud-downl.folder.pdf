",\"subagentStopAllConfirm\":\"Stop {count}?\",\"subagentStopAllConfirmAction\":\"Stop\",\"subagentStopAllDismiss\":\"Cancel\",\"subagentStopping\":\"Stopping…\",\"usedTool\":\"Used {tool}\",\"usedToolCount\":\"{count, plural, =1 {Used # tool} other {Used # tools}}\",\"waitingForApprovalAfterToolSteps\":\"{count, plural, =1 {Waiting for approval after # tool step} other {Waiting for approval after # tool steps}}\",\"showLatestActions\":\"Show latest 5 actions\",\"seeAllActions\":\"See all {count} actions\",\"approvalDecision\":{\"approvedOnceByYou\":\"Approved once by you\",\"allowedForSessionByYou\":\"Allowed for this session by you\",\"usedSessionApproval\":\"Ran using your session approval\",\"deniedByYou\":\"Denied by you\"}},\"thinking\":{\"steps\":\"Thinking steps\",\"showDetails\":\"Show details\",\"hideDetails\":\"Hide details\"},\"showEarlierMessages\":\"Show earlier messages\",\"imageLimitWarning\":\"You have reached the maximum number of images allowed for this chat. Additional images have been automatically removed.\",\"chatCreditUsage\":{\"title\":\"Credit Usage\",\"desc\":\"You've used {consumedCredits} out of {totalCredits} credits this month.\",\"nextEstimatedCredits\":\"Next interaction cost: {nextEstimatedCredits} credits aproximately\",\"estimatedConsumption\":\"Your next message using {model} will cost aproximately {nextEstimatedCredits} credits.\",\"link\":\"Click here to learn more about AI Drive credits\"},\"input\":{\"placeholder\":\"Message AI Drive... Type @ to mention files and folders.\",\"search\":\"Search\",\"for\":\"for\",\"disclaimer\":\"AI Drive can make mistakes. Check important info.\",\"upgradeForAgent\":\"Upgrade to Pro to use AI Drive Agent\",\"stopChat\":\"Stop Chat\",\"upgrade\":\"Upgrade Now\",\"quickOptionsPlaceholder\":\"Use arrows + Enter to choose, or type to minimize.\",\"quickOptionsShow\":\"{count, plural, one {Show # option} other {Show # options}}\",\"quickOptionsHide\":\"Hide options\",\"promptImprovement\":{\"improve\":\"Improve\",\"improveLabel\":\"Improve prompt\",\"improveTooltip\":\"Improve prompt with selected model (Cmd/Ctrl+I)\",\"undo\":\"Undo\",\"undoLabel\":\"Undo prompt improvement\",\"error\":\"Unable to improve prompt right now. Please try again.\"}},\"modelSelector\":{\"chat\":\"Chat\",\"agent\":\"Agent\",\"disabled\":\"(disabled)\",\"recommended\":\"Recommended\",\"creditsPerPage\":\"Relative model rate:\",\"agentCreditsInfo\":\"Learn about agent credit usage\",\"depreciating\":\"Soon to be Deprecated\",\"badgeExpensive\":\"Best accuracy (expensive)\",\"badgeMaximumCapability\":\"Maximum capability (most expensive)\",\"badgeEfficient\":\"Cheap and fast (everyday use)\",\"badgeBalanced\":\"Balanced (recommended)\",\"badgePremium\":\"Premium (advanced)\",\"badgeFast\":\"Fast and efficient\",\"badgeAgentBest\":\"Best for agents\",\"badgeAgentRecommended\":\"Recommended\",\"badgeAgentBalanced\":\"Balanced\",\"badgeAgentAdvanced\":\"Advanced reasoning\",\"badgeAgentPowerful\":\"Powerful\",\"badgeAgentFast\":\"Fast\",\"premiumModel\":\"Premium model — uses premium credits\"},\"addContent\":{\"imagesUnavailable\":\"Choose a model that supports images to attach an image.\",\"addFiles\":\"Add files and more\",\"uploadFiles\":\"Upload files\",\"uploadFailed\":\"Could not upload files. Please try again.\",\"waitingForUploads\":\"Waiting for uploads to finish.\",\"uploadImage\":\"Upload Image\",\"addImageLink\":\"Add Image Link\",\"captureImage\":\"Capture Image\",\"saveChat\":\"Save whole Chat\",\"editChat\":\"Edit whole Chat\",\"shareChat\":\"Share Chat\",\"moreOptions\":\"More options\"},\"usageNotIncludedLimitReached\":\"Not included: Limit reached\",\"usageNotIncludedNonMultimodal\":\"Current model doesn't support image processing\",\"proChatBanner\":{\"message\":\"Chat Mode isn't available on Basic. Continuing this history starts a new GPT-6 Luna Agent conversation; the existing history stays readable. \u003cupgrade\u003eUpgrade to Pro\u003c/upgrade\u003e to continue in Chat Mode or use more models.\",\"useFreeModel\":\"Start Luna Agent\"},\"chatModeBanner\":{\"message\":\"Switch to Agent mode for file operations, multi-step tasks, and better reasoning.\"},\"regionalModelSwitchBanner\":{\"message\":\"Switched to \u003cstrong\u003e{newModel}\u003c/strong\u003e to meet US-only processing requirements. Your chat history is preserved.\",\"deprecationMessage\":\"Switched to \u003cstrong\u003e{newModel}\u003c/strong\u003e because Gemini 3 Flash Preview has been deprecated. Your chat history is preserved.\",\"dismiss\":\"Dismiss model change notice\"},\"notificationBanner\":{\"message\":\"Don't want to wait? Enable notifications and switch to another task — we'll let you know when it's done.\",\"enable\":\"Enable\",\"confirmTitle\":\"Notifications enabled\",\"confirmBody\":\"You'll be notified when your AI response is ready.\"},\"agentModeTooltip\":{\"title\":\"Why Use Agent Mode?\",\"description\":\"Agent mode lets AI Drive plan and execute complex multi-step work on your behalf.\",\"benefits\":{\"multiStep\":{\"title\":\"Multi-step task execution\",\"description\":\"Handles complex workflows that require planning and coordination\"},\"powerfulModels\":{\"title\":\"Access to premium models\",\"description\":\"Use Claude 4.5 Opus, GPT-5, and other high-power AI models\"},\"fileOperations\":{\"title\":\"Advanced file operations\",\"description\":\"Process large files, folders, and perform deep document analysis\"},\"betterReasoning\":{\"title\":\"Extended reasoning\",\"description\":\"AI can think longer and deeper to solve complex problems\"}},\"footer\":\"Credit usage based on tasks processed*\"},\"speechToText\":{\"sessionStatus\":{\"authExpired\":\"Authentication expired. Please refresh the page.\",\"tooManyRequests\":\"Too many requests. Please wait a moment.\",\"serviceUnavailable\":\"Service temporarily unavailable.\",\"failed\":\"Failed to start transcription session\"},\"switchMicError\":\"Could not switch microphone: {message}\",\"audioResumeError\":\"Audio could not be resumed after device switch.\",\"transcriptionError\":\"Transcription error\",\"transcriptionFailed\":\"Transcription failed\",\"errorProcessingMessage\":\"Error processing audio message\",\"signInRequired\":\"Please sign in to use speech-to-text\",\"connectionUnstable\":\"Transcription connection unstable. Please try again.\",\"connectionError\":\"Connection error. Please try again.\",\"audioNotAvailable\":\"Audio is not available. Check device or browser settings.\",\"lostConnection\":\"Lost connection. Transcription stopped.\",\"failedToStartListening\":\"Failed to start listening: {message}\",\"failedToAccessMicrophone\":\"Failed to access microphone: {message}\",\"microphoneDeniedSettings\":\"Microphone access was denied. Please allow access in your browser settings and try again.\",\"ariaAudioDeviceSettings\":\"Audio device settings\",\"microphone\":\"Microphone\",\"defaultSystemDefault\":\"Default (system default)\",\"unknownMicrophone\":\"Unknown Microphone\",\"stop\":\"Stop\"},\"safetyPolicy\":{\"description\":\"Choose another available model to continue this chat. Each model applies its own safety policies.\",\"modelLabel\":\"Model to continue with\",\"continue\":\"Continue with another model\",\"continuePrompt\":\"Please continue with my previous request from where you stopped.\",\"continueError\":\"Couldn't continue. Check the chat's model and try again.\"},\"turnBudget\":{\"label\":\"Budget per turn\",\"nextLabel\":\"Next turn’s budget\",\"credits\":\"credits\",\"edit\":\"Edit\",\"change\":\"Change\",\"save\":\"Save\",\"cancel\":\"Cancel\",\"loading\":\"Loading budget…\",\"saving\":\"Saving…\",\"loadError\":\"Couldn’t load your budget. Please try again.\",\"saveError\":\"Couldn’t save your budget. Please try again.\",\"retry\":\"Try again\",\"invalid\":\"Enter a credit budget greater than 0 and no more than {max}.\",\"title\":\"Turn budget reached\",\"description\":\"This turn reached its {budget}-credit budget. Your work so far is saved.\",\"question\":\"Continue in a new turn?\",\"notice\":\"Your work so far is saved. Send a message to continue.\",\"continue\":\"Continue\",\"saveContinue\":\"Save \u0026 continue\",\"notNow\":\"Not now\",\"continueError\":\"Couldn’t start a new turn. Check the chat message below and try again.\",\"continuePrompt\":\"Continue\"}},\"faqPage\":{\"title\":\"Got questions? We have answers.\",\"questions\":{\"one\":{\"question\":\"What is AI Drive?\",\"answer\":\"AI Drive is an intelligent document management platform that combines cloud storage with advanced AI capabilities. It allows you to upload, organize, and interact with your documents using conversational AI, making document analysis, search, and collaboration more intuitive and efficient.\"},\"chatVsAgents\":{\"question\":\"What's an AI Drive Agent and how is it better than just any AI Chat?\",\"answer\":{\"1\":\"Extract data at scale — pull names, dates, and key terms from thousands of contracts into a spreadsheet\",\"2\":\"Manipulate PDFs — merge, split, redact, or add watermarks across entire document sets\",\"3\":\"Search everything at once — find specific clauses or references across hundreds of case files instantly\",\"4\":\"Create deliverables — generate timelines, comparison reports, and summary memos\",\"desc\":\"Regular AI chat is like texting a smart friend—you ask a question, you get an answer. AI Drive agents are like a skilled assistant helping you get work done:\",\"example\":\"Example: Chat tells you what to look for in an NDA. AI Drive extracts key terms from 500 vendor contracts, flags outliers, and exports a comparison spreadsheet.\"}},\"two\":{\"question\":\"What are the key features of AI Drive?\",\"answer\":{\"1\":\"AI-Powered Document Chat: Interact with your documents using natural language\",\"2\":\"Intelligent Search: Semantic search across all your files and folders\",\"3\":\"Document Analysis: Extract insights, summaries, and key information\",\"4\":\"Secure Cloud Storage: Enterprise-grade security for your documents\",\"5\":\"Multi-format Support: PDF, DOCX, images, and more\",\"6\":\"Collaboration Tools: Share and collaborate on documents with AI assistance\",\"7\":\"API Integration: Programmatic access for Business Account\",\"desc\":\"AI Drive offers several advanced features:\"}},\"three\":{\"question\":\"How can I get started with AI Drive?\",\"answer\":{\"1\":\"Sign up at myaidrive.com\",\"2\":\"Upload your first document\",\"3\":\"Start chatting with your documents\",\"4\":\"Explore advanced features like smart search that can understand what you mean (not just exact words) and AI Assistants that can read, summarize, and extract key information from your documents instantly.\"}},\"four\":{\"question\":\"How can I use AI Drive?\",\"answer\":{\"1\":\"Summarize the key points in this contract.\",\"2\":\"Find all mentions of pricing in these documents.\",\"3\":\"Create a chronological timeline of all events from this case file.\",\"4\":\"What are the main themes in this research paper?\",\"desc\":\"Simply upload your documents and start asking questions in natural language. For example:\"}},\"five\":{\"question\":\"How does AI Drive enhance document management?\",\"answer\":{\"1\":\"Query documents using natural language\",\"2\":\"Get instant summaries and insights\",\"3\":\"Find specific information across multiple documents\",\"4\":\"Generate reports and analysis\",\"5\":\"Collaborate with an AI-enhanced understanding\",\"6\":\"Chat with entire folders containing hundreds of files simultaneously\",\"7\":\"Create custom AI agents tailored to your specific workflows\",\"8\":\"Extract structured data automatically from documents\",\"desc\":\"AI Drive transforms static documents into interactive, searchable knowledge bases. You can:\"}},\"six\":{\"question\":\"What are AI Drive's Custom AI Agents?\",\"answer\":{\"1\":\"Personalized AI assistants that understand your domain expertise\",\"2\":\"Agent chat functionality for specialized tasks and workflows\",\"3\":\"Custom training on your document collections for domain-specific insights\",\"4\":\"Email integration (Business plan) - send tasks directly to your AI agent via email\",\"5\":\"Shareable agents - collaborate by sharing AI agents with team members\",\"6\":\"Professional optimization for legal, business, and enterprise use cases\",\"desc\":\"AI Drive offers powerful custom AI agents that can be trained on your specific documents and workflows:\"}},\"seven\":{\"question\":\"How does Folder Search work?\",\"answer\":{\"1\":\"Semantic search across entire folders with hundreds of documents\",\"2\":\"Multi-file querying - ask questions that span your entire document collection\",\"3\":\"Intelligent organization - AI helps categorize and structure your files\",\"4\":\"Cross-document insights - find connections and patterns across multiple files\",\"5\":\"Folder-level AI agents that understand the context of your entire document collection\",\"desc\":\"AI Drive's advanced folder search capabilities include:\"}},\"eight\":{\"question\":\"What is the Credits System?\",\"answer\":{\"1\":\"Basic Plan: 2,000 credits per month (free)\",\"2\":\"Pro Plan: 50,000 credits per month ($39/month)\",\"3\":\"Business Plan: 300,000 credits per month ($200/month)\",\"4\":\"Credits are consumed based on AI model usage, document processing, and feature utilization\",\"5\":\"Basic includes GPT-6 Luna in Agent Mode; Pro and Business unlock additional AI models\",\"6\":\"Flexible usage - use credits as needed across different AI models and features\",\"7\":\"Basic includes up to 50 owned files and 10 owned folders from October 1, 2026. Existing content stays safe and accessible; if you are over a limit, delete items or upgrade before adding more.\",\"desc\":\"AI Drive uses a credits-based pricing model for fair usage:\"}},\"nine\":{\"question\":\"Can AI Drive process scanned documents or images within PDFs?\",\"answer\":\"Yes, AI Drive uses advanced OCR (Optical Character Recognition) technology to extract text from scanned documents and images, making them fully searchable and interactive.\"},\"ten\":{\"question\":\"Can I chat with more than one PDF at once?\",\"answer\":\"Absolutely! AI Drive allows you to upload multiple documents and query them simultaneously. You can ask questions that span across your entire document collection.\"},\"eleven\":{\"question\":\"Is AI Drive suitable for professional use?\",\"answer\":{\"1\":\"Enterprise-grade security and compliance\",\"2\":\"Advanced collaboration features\",\"3\":\"API access for business integrations\",\"4\":\"Scalable storage and processing\",\"5\":\"Professional support options\",\"desc\":\"Yes, AI Drive is designed for professional environments with:\"}},\"twelve\":{\"question\":\"How secure is AI Drive for storing sensitive documents?\",\"answer\":{\"1\":\"End-to-end encryption for data in transit and at rest\",\"2\":\"SOC 2 Type 2 examination completed\",\"3\":\"Regular security audits and penetration testing\",\"4\":\"Access controls and permission management\",\"5\":\"U.S. stored-data residency and optional Enterprise U.S.-only AI model execution\",\"desc\":\"AI Drive employs enterprise-grade security measures:\"}},\"thirteen\":{\"question\":\"Who has access to my documents and conversations?\",\"answer\":{\"1\":\"You own your data: All uploaded documents and AI interactions belong to you\",\"2\":\"Limited human review: Only authorized personnel may review content for safety, security, or legal compliance purposes\",\"3\":\"No data selling: We never sell your data to third parties\",\"4\":\"Automated safety systems: AI-powered content moderation with minimal human intervention\"}},\"fourteen\":{\"question\":\"Does AI Drive use my documents to train AI models?\",\"answer\":{\"1\":\"Your documents are NOT used for general AI training\",\"2\":\"This applies to Free, Pro, Business, and Enterprise accounts\",\"desc\":\"No. AI Drive does not train models on your data. By default:\"}},\"fiveteen\":{\"question\":\"My PDFs are on my computer or they are private/confidential. What can I do?\",\"answer\":{\"1\":\"Upload directly: Drag and drop files from your computer\",\"2\":\"Secure storage: All documents are encrypted and private to your account\",\"3\":\"Local processing options: Enterprise plans include on-premise deployment\",\"4\":\"Batch upload: Upload entire folders and maintain organization\",\"desc\":\"No problem! AI Drive is designed for private documents:\"}},\"sixteen\":{\"question\":\"How can I organize my documents?\",\"answer\":{\"1\":\"Folder structure: Create custom folders and subfolders\",\"2\":\"Search everything: Find documents by content, not just filename\",\"3\":\"Use AI Drive Agent to organize your files\",\"desc\":\"AI Drive offers flexible organization:\"}},\"seventeen\":{\"question\":\"How do I delete my conversations and documents?\",\"answer\":{\"1\":\"Individual deletion: Remove specific conversations or documents\",\"2\":\"Bulk deletion: Clear entire folders or conversation history\",\"3\":\"Account deletion: Complete removal with 30-day data retention\",\"4\":\"Download first: Export all your data before deletion\",\"desc\":\"You have complete control:\"}},\"eighteen\":{\"question\":\"How long does AI Drive retain my information?\",\"answer\":{\"1\":\"User-controlled: Keep data as long as you want\",\"2\":\"Deleted content: Removed within 30 days of deletion request\",\"3\":\"Account closure: All data deleted within 30 days\"}},\"nineteen\":{\"question\":\"What file formats are supported?\",\"answer\":{\"1\":\"Documents: PDF, DOCX, DOC, TXT, MD\",\"2\":\"Presentations: PPTX, PPT\",\"3\":\"Spreadsheets: XLSX, XLS, CSV\",\"4\":\"Pro and Business Plans: Images: JPG, PNG, JPEG, WEBP, HEIC\",\"5\":\"Code files: Most programming languages\",\"desc\":\"AI Drive supports:\"}},\"twenty\":{\"question\":\"Do you have an API or integration options?\",\"answer\":{\"1\":\"REST API: Full programmatic access to all features for Business Users\",\"desc\":\"Yes! AI Drive offers:\"}},\"twentyone\":{\"question\":\"The AI is giving incorrect or unhelpful responses. What should I do?\",\"answer\":{\"1\":\"Be specific: Use clear, detailed questions\",\"2\":\"Provide context: Reference specific sections or documents\",\"3\":\"Verify information: Always double-check important facts\",\"desc\":\"AI responses may sometimes be inaccurate. Here's how to improve results:\"}},\"twentytwo\":{\"question\":\"My documents won't upload. What should I check?\",\"answer\":{\"1\":\"File size: Check if your file exceeds size limits (2GB for each PDF file, 100 MB for TXT files)\",\"2\":\"Format support: Ensure file type is supported\",\"3\":\"Network connection: Verify stable internet connection\",\"4\":\"Browser issues: Try clearing cache or different browser\",\"desc\":\"Common solutions:\"}},\"twentythree\":{\"question\":\"Where can I find updates and new features?\",\"answer\":{\"1\":\"Release Notes: \u003creleasenotes\u003e{releasenotes}\u003c/releasenotes\u003e\",\"2\":\"Blog: \u003cblog\u003e{blog}\u003c/blog\u003e\",\"desc\":\"Stay informed about AI Drive:\"}},\"twentyfour\":{\"question\":\"Additional resources\",\"answer\":{\"1\":\"Terms and Conditions: \u003creleasenotes\u003e{releasenotes}\u003c/releasenotes\u003e\",\"2\":\"Privacy Policy: \u003cprivacy\u003e{privacy}\u003c/privacy\u003e\",\"3\":\"Security Documentation: \u003csecurity\u003e{security}\u003c/security\u003e\",\"4\":\"Video Tutorials: \u003cvideo\u003e{video}\u003c/video\u003e\"}},\"twentyfive\":{\"question\":\"I have a different question\",\"answer\":\"Please email \u003cemail\u003e{email}\u003c/email\u003e and we will get back to you as soon as possible.\"},\"twentysix\":{\"question\":\"The Stripe payment link won't load, shows \\\"Can't load the page\\\" error, or freezes when entering card details. What should I do?\",\"answer\":{\"desc\":\"Open the payment link in an incognito/private browser window. This resolves most loading and freezing issues caused by browser cache, cookies, or extensions.\",\"howTo\":{\"1\":\"Chrome/Edge: Press Ctrl+Shift+N (Windows) or Cmd+Shift+N (Mac)\",\"2\":\"Firefox: Press Ctrl+Shift+P (Windows) or Cmd+Shift+P (Mac)\",\"3\":\"Safari: File → New Private Window\",\"title\":\"How to open incognito mode:\"},\"alternatives\":{\"1\":\"Try a different browser (Chrome, Firefox, Safari, Edge)\",\"2\":\"Try from a different device (phone or tablet)\",\"3\":\"Confirm your card has sufficient funds and is active with your bank\",\"4\":\"Contact our support team if the issue persists\",\"title\":\"If incognito mode doesn't work:\"}}}}},\"fulfillmentPolicy\":{\"here\":\"here\",\"link\":\"Questions about refunds and cancellations ? Check out our fulfillment policy \u003c2\u003e{link}\u003c/2\u003e .\",\"heading\":\"Fulfillment Policy\",\"commonInfo\":\"We are committed to ensuring the satisfaction of our customers with our products and services. If, for any reason, you are not Completely satisfied with your purchase, we are here to help.\",\"refunds\":{\"title\":\"Refunds\",\"desc\":\"If you're not satisfied with your purchase, you can request a refund by emailing us at help@myaidrive.com within 15 days of your payment. We aim to process refunds promptly for products that don't meet your expectations.\"},\"cancellations\":{\"title\":\"Subscription Cancellations\",\"desc\":\"You can cancel your subscription anytime by navigation to 'Account' \u003e 'Subscription' \u003e 'Manage Subscription'. Cancellations take effect immediately, but access continues until the end of the current billing cycle.\"},\"bottomInfo\":\"For assistance, reach out to us at \u003cemail\u003e{email}\u003c/email\u003e .\"},\"contactPage\":{\"infoBanner\":\"Our Founders \u003cfounder1\u003e{founder1}\u003c/founder1\u003e and \u003cfounder2\u003e{founder2}\u003c/founder2\u003e are based in Silicon Valley, California and have many years of experience at top internet companies\",\"infoFirst\":{\"title\":\"We're here for you\",\"desc\":\"At \u003caiDrive\u003e{aiDrive}\u003c/aiDrive\u003e and \u003caiPdf\u003e{aiPdf}\u003c/aiPdf\u003e, we value our users above all. As a small team committed to your satisfaction, we take your feedback and support cases seriously, ensuring each one receives the attention it deserves. If you need assistance or have any questions, we're ready to help:\"},\"infoSecond\":{\"title\":\"Email Us\",\"desc\":\"Connect with us at \u003cemail\u003e{email}\u003c/email\u003e for any support-related queries. We aim to address all emails promptly.\"},\"infoThird\":{\"title\":\"Contact Form\",\"desc\":\"Alternatively, you can use our contact form to send us your inquiries or comments. Simply click the link below, and we'll be in touch.\",\"link\":\"Go To Contact Form\"},\"thankuInfo\":\"Thank you for trusting AI Drive with your document workflows.\"},\"privacyPolicyPage\":{\"title\":\"AI Drive Privacy Policy\",\"publishedDate\":\"Published on September 4th, 2023\",\"introduction\":\"AI Drive is a \u003ccompany\u003e{company}\u003c/company\u003e product. At V2K AI, we respect the privacy of our users and are committed to being transparent about how we collect and use your data. This Privacy Policy explains how AI Drive handles your personal information when you visit our website or use our services.\",\"informationWeCollect\":{\"title\":\"Information We Collect\",\"content\":{\"description\":\"We collect information you provide directly to us, information obtained through your use of AI Drive, and information from third party sources, as detailed below:\",\"point1\":\"Account Information: We collect information you provide when you create an AI Drive account, including your name, email address, and any other information you choose to provide.\",\"point2\":\"Documents: We collect the documents and files you upload to AI Drive for storage and access.\",\"point3\":\"Search Queries and Prompts: We collect the search terms, queries, and prompts you enter when interacting with your documents through the AI Drive service.\",\"point4\":\"Usage Data: We collect information about how you interact with AI Drive, such as document search and access history, clicks, date and time of access, and referring webpage addresses.\",\"point5\":\"Device Information: We may collect information about the device and software you use to access AI Drive, such as IP address, browser type, operating system version, and cookie data.\",\"point6\":\"Third Party Data: We may supplement information we collect with demographic data or other attributes from third party sources. This data is aggregated or anonymized prior to our receipt.\"}},\"howWeUseInformation\":{\"title\":\"How We Use Information\",\"content\":{\"description\":\"We use your information for the following purposes:\",\"point1\":\"To provide you with access to AI Drive and its document management and AI search and summarization capabilities.\",\"point2\":\"To refine our document processing algorithms and models to deliver more relevant results and valuable features to you and other users.\",\"point3\":\"To troubleshoot issues, discover needs for new features and make improvements to the AI Drive service.\",\"point4\":\"To communicate with you, provide customer support, and respond to inquiries.\",\"point5\":\"To ensure security and prevent fraud, spam, and abuse.\",\"note\":\"We do not use your documents, queries, or other data for unrelated analytics or research purposes. We only retain and use your information while your account is active or for a limited period thereafter, as detailed in the Data Retention section below.\"}},\"dataSharing\":{\"title\":\"Data Sharing \u0026 Third Parties\",\"content\":\"We use trusted service providers like Google Cloud and OpenAI to deliver key product functions. We do not sell or share your personal data with third parties for their marketing purposes. If you use one of our ChatGPT Plugins (including the AI PDF and AI Drive plugins), your data will also be subject to Open AI's ChatGPT policies and terms of use. Make sure to review \u003cpolicy\u003e{policy}\u003c/policy\u003e and \u003cterms\u003e{terms}\u003c/terms\u003e. Contact Open AI if you have additional questions.\"},\"dataRetention\":{\"title\":\"Data Retention\",\"point1\":\"Account information is retained while your account remains active. If you close your account, your account information and documents will be marked for deletion and removed from our systems within 30 days.\",\"point2\":\"Documents, search queries, and prompts are retained while your account remains active and the specific document exists. If you delete a document it will be removed from our systems within 30 days.\",\"point3\":\"Usage data, anonymized search queries, prompts and document embeddings may be retained up to one year after account closure solely to improve our services. These are not associated with individual accounts.\"},\"yourChoices\":{\"title\":\"Your Choices\",\"description\":\"You have the following control over your information:\",\"point1\":\"You can delete your account and its associated data by emailing \u003cemail\u003e{email}\u003c/email\u003e. Account data will be deleted according to the policies specified in the Data Retention section.\",\"point2\":\"You can delete uploaded documents at any time using the AI Drive user interface.\"},\"childrenPrivacy\":{\"title\":\"Children's Privacy:\",\"description\":\"Our service is not directed to children, and we do not knowingly collect data from them.\"},\"noteAboutAccuracy\":{\"title\":\"Note about Accuracy\",\"para1\":\"AI Drive utilizes novel artificial intelligence technologies to analyze and summarize documents. However, the document search results and summaries provided by AI Drive may not always be comprehensive or fully relevant to the original content.\",\"para2\":\"In addition, third party services like ChatGPT that interface with AI Drive may further interpret our outputs in ways we do not control. In some cases, this could result in factual inaccuracies or hallucinations unrelated to the original content.\",\"para3\":\"If you notice any significant inaccuracies, please contact us at \u003cemail\u003e{email}\u003c/email\u003e and we will investigate possible solutions or workarounds. However, due to the technical limitations of current AI systems, we may not be able to correct or remove the outputs in all cases.\",\"para4\":\"We advise users to critically evaluate the relevance and accuracy of AI-generated outputs and not solely rely on them for factual information without additional verification. We are actively working to improve our systems to address these types of issues.\"},\"changesToPolicy\":{\"title\":\"Changes to this Policy\",\"content\":\"We may periodically update this Privacy Policy. The latest version will always be available on the \u003cwebsite\u003e{website}\u003c/website\u003e. Your continued use of our services after any changes signifies your agreement to the new policy.\"},\"contact\":{\"title\":\"Contact Us\",\"content\":\"If you have any questions about our privacy practices or this policy, please contact us at \u003cemail\u003e{email}\u003c/email\u003e\"}},\"termsPage\":{\"title\":\"Terms and Conditions\",\"publishedDate\":\"Published on September 4th, 2023\",\"introductionTitle\":\"1. Introduction\",\"introductionDesc\":\"Thank you for choosing AI Drive from \u003cv2kAiInc\u003e{v2kAiInc}\u003c/v2kAiInc\u003e. These Terms of Use apply when you use AI Drive's services, including our application, plugins, tools, and interfaces. By using our services, you agree to these terms.\",\"userDataHandling\":\"2. User Data Handling and Privacy\",\"userDataHandlingDesc\":\"Please refer to our \u003cprivacyPolicy\u003e{privacyPolicy}\u003c/privacyPolicy\u003e for details on how AI Drive handles user data. Users must provide accurate registration information and are responsible for all activities under their credentials.\",\"userResponsibilities\":\"3. User Responsibilities\",\"userResponsibilitiesDesc\":\"Users have the responsibility to comply with these terms and all applicable laws when using AI Drive. They are prohibited from using the services in ways that infringe, misappropriate, or violate any person's rights.\",\"limitations\":\"4. Limitations and Disclaimers\",\"limitationsDesc\":\"AI Drive is provided 'as is.' Users should not use AI Drive as the sole repository of their documents as we cannot guarantee against loss, whether total or partial. \u003cnoteAboutAccuracy\u003e{noteAboutAccuracy}\u003c/noteAboutAccuracy\u003e: AI Drive utilizes novel artificial intelligence technologies to analyze and summarize documents. However, the results and summaries may not always be comprehensive or fully relevant. Third-party services like ChatGPT that interface with AI Drive may further interpret our outputs in ways we do not control. In some cases, this could result in factual inaccuracies or hallucinations unrelated to the original content. If you notice any significant issues, please contact us at \u003cemail\u003e{email}\u003c/email\u003e. We advise users to critically evaluate the relevance and accuracy of AI-generated outputs and not solely rely on them without additional verification.\",\"integration\":\"5. Integration with Other Services (APIs)\",\"integrationDesc\":\"Any third-party software, services, or products used in connection with AI Drive are subject to their own terms. Users are expected to be aware of and comply with the terms and conditions of any third-party services they integrate with AI Drive. If you use the AI PDF or AI Drive plugins for ChatGPT, you must also agree to \u003copenAisTerms\u003e\u003c/openAisTerms\u003e \u003cdataSharing\u003e\u003c/dataSharing\u003e: We partner with trusted providers like Google Cloud and OpenAI to deliver key product functions. We do not sell or share your personal data with third parties for their marketing purposes.\",\"termination\":\"6. Termination and Account Deletion\",\"terminationDesc\":\"The terms of use take effect when users first use the services and remain in effect until terminated. Users can terminate the terms at any time by discontinuing the use of the services. AI Drive can terminate the terms by providing at least 30 days' advance notice or immediately upon notice for material breaches. Upon termination, users must stop using the services.\",\"updates\":\"7. Updates and Modifications to the Terms\",\"updatesDesc\":\"The latest terms of use will always be available on our \u003cwebsite\u003e{website}\u003c/website\u003e. Continued use of AI Drive signifies agreement to any modifications.\"},\"securityPage\":{\"title\":\"AI Drive Security\",\"securityPractices\":{\"title\":\"Our Security Practices\",\"desc\":\"At AI Drive and AI PDF, we take security very seriously. Our founders leverage decades of joint experience in data security and privacy at large companies to build security into our products and processes.\"},\"background\":{\"title\":\"Our Background\",\"list\":{\"headquarters\":{\"name\":\"Headquarters\",\"desc\":\"Sunnyvale, California\"},\"partnerships\":{\"title\":\"Partnerships\",\"partner1\":{\"name\":\"Microsoft Level 2 Partner\",\"desc\":\"Recognized for our integration and collaboration with Microsoft technologies.\"},\"partner2\":{\"name\":\"NVIDIA Inception Partner\",\"desc\":\"Partnered with NVIDIA to leverage AI and deep learning technologies.\"},\"partner3\":{\"name\":\"Google for Startups Program Partner\",\"desc\":\"Accepted into Google's selective program which gives us access to technology and resources from a leading cloud services provider.\"},\"partner4\":{\"name\":\"Cloud Security Alliance Member\",\"desc\":\"Committed to cloud security best practices.\"}},\"founderExpertise\":{\"title\":\"Founder's Expertise\",\"desc\":\"Our co-founders, Karthik and Vicente, bring over two decades of combined experience in online security\",\"founder1\":{\"name\":\"Karthik\",\"desc\":\"Formerly with Google Cloud AI, he has extensive experience in managing large-scale, secure cloud infrastructure.\"},\"founder2\":{\"name\":\"Vicente\",\"desc\":\"Previously a Product Manager for privacy at WhatsApp/Meta, Vicente has a deep understanding of user privacy and data protection. Together, they have built the Trust team at LinkedIn and the Risk Data Science team at Uber.\"}}}},\"securityMeasures\":{\"title\":\"Key Data Security Measures\",\"measure1\":{\"name\":\"TLS Encryption\",\"desc\":\"All traffic to and from our services is encrypted using Transport Layer Security (TLS) by default, ensuring secure communication.\"},\"measure2\":{\"name\":\"Data Encryption at Rest\",\"desc\":\"We encrypt all stored data by default with high grade AES-256 encryption to protect your information from unauthorized access.\"},\"measure3\":{\"name\":\"Data Storage\",\"desc\":\"Our data is stored in Google US data centers, which are renowned for their security and reliability.\"}},\"privacy\":{\"title\":\"Privacy and Data Access\",\"userPrivacy\":{\"name\":\"User Privacy\",\"desc\":\"Your files are private and not accessible to other users unless you share your login credentials or the secure link generated for your files. For detailed privacy practices, please refer to our \u003cprivacyPolicy\u003e{privacyPolicy}\u003c/privacyPolicy\u003e.\"},\"accessControl\":{\"name\":\"Access Control\",\"desc\":\"We use segregation of duties to ensure that only a minimal number of trusted employees have access to production servers and databases.\"}},\"compliance\":{\"name\":\"Compliance\",\"desc\":\"V2K AI, Inc. has completed a SOC 2 Type 2 examination covering Security, Availability, and Confidentiality.\"},\"commitment\":\"Our commitment to security is unwavering, and we continuously strive to improve our practices to protect your data. For more detailed information on our privacy practices, please refer to our \u003cprivacyPolicy\u003e{privacyPolicy}\u003c/privacyPolicy\u003e and \u003cterms\u003e{terms}\u003c/terms\u003e.\",\"contact\":\"For any questions or additional information, feel free to contact us. Thank you for trusting AI Drive and AI PDF with your digital document needs.\",\"enterpriseCallout\":{\"title\":\"Enterprise Security \u0026 Compliance\",\"description\":\"Enterprise users benefit from additional security features including HIPAA compliance, zero data retention options, detailed audit logs, and dedicated support. Our enterprise-grade security infrastructure provides the highest level of protection for organizations with strict compliance requirements.\",\"learnMore\":\"Learn more about Enterprise Security Features\"}},\"blackFriday\":{\"title\":\"Choose your Perfect Plan\",\"choosePlan\":\"Limited time offer!\",\"billingPeriods\":{\"yearly\":\"Yearly\",\"monthly\":\"Monthly\"},\"getStarted\":\"Get Started\",\"mostPopular\":\"Most Popular\",\"monthlyNotAvailable\":\"Monthly Plans are not available for Teams\",\"blackFridaySale\":\"15% OFF Black Friday Sale!\",\"ocrDetails\":\"Each page processed with OCR or Haiku AI consumes one credit. More powerful AI models consume additional credits, \",\"refundPolicy\":\"Questions about refunds and cancellations? Check out our \",\"clickHere\":\"click here for details\",\"fulfillmentPolicyHere\":\"fulfillment policy here\",\"plans\":{\"free\":{\"name\":\"Basic\",\"price\":\"$$0\",\"period\":\"\",\"credits\":\"2,000 credits per month\",\"features\":{\"1\":\"2,000 credits per month\",\"2\":\"From October 1, 2026: store up to 50 owned files and 10 owned folders\",\"3\":\"GPT-6 Luna in Agent Mode\",\"4\":\"Limited metadata description of files: Only 5 files\",\"5\":\"Move/Copy of files is available\"}},\"individual\":{\"name\":\"Pro\",\"monthly\":{\"price\":\"$$39.00\",\"discountedPrice\":\"$$33.15\",\"period\":\"/month\",\"credits\":\"50,000 credits per month\",\"discount\":\"15% OFF Black Friday Sale!\",\"lineThroughPrice\":\"$$39.00/month\",\"discountInformation\":\"Switch to yearly for 38% Off\"},\"yearly\":{\"price\":\"$$299.00\",\"pricePerMonth\":\"$$24.92\",\"discountedPrice\":\"$$254.15\",\"period\":\"/year\",\"credits\":\"50,000 credits per month\",\"discount\":\"15% OFF Black Friday Sale!\",\"freeTrial\":\"38% savings vs monthly plan\",\"lineThroughPrice\":\"$$468.00/year\",\"discountInformation\":\"38% Off monthly pricing\",\"discountedLineThroughPrice\":\"$$299.00/year\",\"billedAnnually\":\"Billed Annually\"},\"features\":{\"1\":\"50,000 credits per month\",\"2\":\"Access to all the latest AI models - OpenAI, Claude, and Google Gemini\",\"3\":\"Unlimited batch upload\",\"4\":\"Advanced AI-powered search\",\"5\":\"Document summarization\",\"6\":\"Data extraction\",\"7\":\"OCR (Optical Character Recognition)\",\"8\":\"AI Drive Agent\",\"9\":\"Folder Search\"}},\"team\":{\"name\":\"Teams\",\"price\":\"$$59.00\",\"discountedPrice\":\"$$50.15\",\"period\":\"per user /month\",\"minUsers\":\"3\",\"credits\":\"100,000 credits per month\",\"discount\":\"15% OFF Black Friday Sale!\",\"monthlyNotAvailable\":\"Monthly Plans are not available for Teams\",\"minimumUsersBilledAnnually\":\"Minimum of {minUsers} users, billed annually ($2,124.00/year)\",\"lineThroughPrice\":\"$$59.00 per user /month\",\"features\":{\"1\":\"100,000 credits per month\",\"2\":\"Access to all the latest AI models - OpenAI, Claude, and Google Gemini\",\"3\":\"Unlimited batch upload\",\"4\":\"Advanced AI-powered search\",\"5\":\"Document summarization\",\"6\":\"Data extraction\",\"7\":\"OCR (Optical Character Recognition)\",\"8\":\"AI Drive Agent\",\"9\":\"Folder Search\",\"10\":\"Priority support\",\"11\":\"Onboarding call with AI Drive founder\",\"12\":\"Access to Early Access Program\",\"13\":\"Team file and folder sharing\"}}},\"promoBanner\":{\"highlight\":\"Black Friday Deal: AI Drive Pro 15% OFF!\",\"subHighlight\":\"Unlock the top AIs + chat with folders of docs at our lowest price!\",\"button\":\"Get AI Drive Pro\"},\"alreadyPro\":\"You already have a pro account\",\"alreadyTeams\":\"You already have a business account\"},\"upgradeToTeams\":{\"mainTitle\":\"Supercharge Your Team's Productivity\",\"mainSubTitle\":\"Unlock AI-powered collaboration for your entire team. Scale smarter, work faster, achieve more together.\",\"getTeams\":\"Get AI Drive Teams\",\"price\":\"$$59 per user /month\",\"priceSubTitle\":\"Minimum of 3 users, billed annually\",\"featuresTitle\":\"Your Team's Features\",\"featuresSubTitle\":\"Experience the full power of collaborative document management\",\"getStarted\":\"Get Started\",\"featureTeamCollaboration\":\"Team Collaboration\",\"featureTeamCollaborationSubtitle\":\"File and Folder Sharing\",\"featureCredits\":\"100,000 credits per month\",\"featureCreditsSubtitle\":\"Monthly allocation\",\"featurePrioritySupport\":\"Priority Support\",\"featurePrioritySupportSubtitle\":\"Priority support for your team\",\"featureUnlimitedUpload\":\"Unlimited Upload\",\"featureUnlimitedUploadSubtitle\":\"Batch processing enabled\",\"featureEAP\":\"Access to Early Access Program\",\"featureAIDriveAgent\":\"AI Drive Agent\",\"featureDocumentSummarization\":\"Document Summarization\",\"featureOnboardingCall\":\"Onboarding call with AI Drive founder\",\"featureDataExtraction\":\"Data Extraction\",\"featureOCR\":\"OCR (Optical Character Recognition)\",\"featureFolderSearch\":\"Folder Search\",\"featureWebSearch\":\"Integrated AI Web Search\",\"featureLatestModels\":\"Latest AI Models\",\"featureAdvancedSearch\":\"Advanced AI Powered Search\"},\"aiMarketPlacePage\":{\"title\":\"AI Marketplace\",\"thisText\":\"this\",\"intro\":\"We are committed to offering you the best AI models available in the market. We partner with leading proprietary and open-source providers to ensure you have early access to the latest technology to get your document work done faster and with higher quality.\",\"tryOutTitle\":\"Try It Out:\",\"whyVarMattersTitle\":\"Why Variety Matters:\",\"tryOutDescription\":\"The table below compares models in the AI Drive catalog, including each model’s provider, plan access, supported mode, capability tier, and live relative model rate. Which models you can use depends on your plan and, where applicable, your team’s model-access settings.\",\"linkToCredits\":\"To learn how credits work and what consumes them, visit \u003cthisText\u003e{thisText}\u003c/thisText\u003e Credits page.\",\"whyVarMatters\":\" Each AI model has unique strengths and their performance also depends on your document content and workflow goals. Our commitment to variety also assures that your AI workflows are not locked-in to a particular provider, which is especially important as the AI field evolves rapidly.\",\"table\":{\"header\":{\"model\":\"Model\",\"provider\":\"Provider\",\"planAccess\":\"Plan access\",\"availableIn\":\"Available in\",\"speed\":\"Speed\",\"reasoning\":\"Reasoning\",\"context\":\"Context\",\"costpage\":\"Cost p/page\",\"whyLike\":\"Why we like it \"},\"access\":{\"freeAndPaid\":\"Free and paid plans\",\"paid\":\"Paid plans\",\"earlyAccess\":\"Early access\",\"planDependent\":\"Plan dependent\"},\"mode\":{\"chat\":\"Chat\",\"agent\":\"Agent\",\"both\":\"Chat and Agent\"},\"whyWe\":{\"gemini2Flash\":\"Ultra-fast processing with excellent value - perfect for quick document analysis and long documents\",\"gemini25Flash\":\"Lightning-fast performance with enhanced reasoning - ideal for rapid document processing\",\"claude3Haiku\":\"Balanced speed and cost - great for everyday document tasks with solid reasoning\",\"gemini15Pro\":\"Exceptional context handling - processes massive documents with deep understanding\",\"gemini20Pro\":\"Advanced reasoning with massive context - excels at complex document analysis\",\"gemini25Pro\":\"Premium reasoning capabilities with extensive context - perfect for sophisticated document workflows\",\"gpt4o\":\"OpenAI's flagship model - outstanding reasoning and creativity for complex document analysis\",\"gpt4oMini\":\"Fast and efficient - great balance of speed and reasoning for most document tasks\",\"gpt41\":\"Enhanced reasoning with improved performance - excellent for analytical document work\",\"gpt5Mini\":\"Lightning-fast with solid reasoning - perfect for quick document insights and summaries\",\"claude37Sonnet\":\"Anthropic's reasoning powerhouse - exceptional analytical capabilities for complex documents\",\"claude4Sonnet\":\"Next-generation reasoning - unparalleled analytical depth for sophisticated document analysis\",\"openaiO1\":\"Revolutionary reasoning model - breakthrough performance for the most challenging document tasks\",\"openaiO3Mini\":\"Advanced reasoning at scale - powerful analysis with efficient processing\",\"openaiO3\":\"Cutting-edge reasoning technology - state-of-the-art performance for complex document analysis\",\"gpt5\":\"OpenAI's latest reasoning model - exceptional analytical capabilities for sophisticated workflows\",\"deepseekR1\":\"Specialized reasoning model - excellent for analytical document tasks and data extraction\",\"deepseekV3\":\"Advanced reasoning capabilities - great performance for complex document analysis\"}},\"footerFirst\":\"If you want to dive deeper,\u003cresearchPaper\u003e{researchPaper}\u003c/researchPaper\u003e  evaluating different models against a standard benchmark such as grade school math.\",\"researchPaper\":\" here is a recent research paper \"},\"creditsPage\":{\"title\":\"Understanding AI Drive Credits\",\"intro\":\"Your AI Drive credits are the key to unlocking advanced capabilities within our platform. You can use your credits for a variety of tasks, including OCR (Optical Character Recognition) and processing with our AI models.\",\"ocrTasksTitle\":\"OCR Tasks:\",\"aiModalTaskTitle\":\"AI Model Tasks:\",\"ocrTasks\":\"Each page you process with OCR consumes one credit.\",\"aiModalTask\":\"For AI-powered tasks, credit use varies with the model, the amount of content, and the type of work. The table below provides a broad relative comparison of the standard token rates for the models currently available to you; it is not a credit estimate for a page or task.\",\"agentModeTitle\":\"Agent Mode\",\"agentModeDescription\":\"Agent mode lets AI Drive plan and complete multi-step work across your documents and connected tools. Credit use reflects the work completed—selected model and reasoning level, pages or content read, tool calls, and any parallel or retried steps. Higher-capability or higher-reasoning choices can use more credits. Available models depend on your plan and your team's model-access settings.\",\"buyCredits\":\"Pro users can buy add-on credits\u003chere\u003e{here}\u003c/here\u003e  to increase their monthly limits\",\"whatConsumesCreditsTitle\":\"What consumes credits\",\"whatConsumesCredits\":{\"modelReasoning\":{\"title\":\"Model reasoning:\",\"description\":\"Time spent by the selected model(s) thinking, planning, and generating results. Higher-capability models or higher reasoning settings can use more credits per unit of work than efficient models.\"},\"toolsUsed\":{\"title\":\"Tools used:\",\"description\":\"Each tool the Agent invokes (document reader, web fetch, data extraction, semantic search, comparison, etc.) contributes to usage based on its run time and complexity.\"},\"pagesRead\":{\"title\":\"Pages read:\",\"description\":\"Credits scale with volume. Reading more pages across more files costs more than reading a few pages in a single file.\"},\"webContentRetrieval\":{\"title\":\"Web/content retrieval:\",\"description\":\"When the Agent fetches external pages or downloads files for analysis, those actions and any subsequent parsing/reading are counted.\"},\"parallelSubtasksRetries\":{\"title\":\"Parallel subtasks and retries:\",\"description\":\"When the Agent branches work or retries a step to improve quality, those additional actions are included.\"}},\"chatModeTitle\":\"Chat Mode\",\"chatModeDescription\":\"Compare the models currently available to you. Relative model rate is a broad comparison of each model's standard token rate—not an estimate for a particular task.\",\"lastPara\":\"Check out our \u003caiMarketPlace\u003e{aiMarketPlace}\u003c/aiMarketPlace\u003e page to see each model's provider, plan access, and whether it's available in Chat, Agent, or both.\u003cseeMyUsage\u003e{seeMyUsage}\u003c/seeMyUsage\u003e\",\"seeMyUsage\":\"See my usage\",\"creditTable\":{\"usProcessingNotice\":\"Gemini 3.1 Pro Preview is unavailable for your team due to US-only processing requirements.\",\"chatModel\":\"Chat Model\",\"title\":\"Relative model rate\",\"modelTier\":\"Model tier\",\"notRated\":\"Not rated\",\"fetchError\":\"Could not fetch models.\",\"emptyCatalog\":\"No models are currently available.\",\"disclaimer\":\"Relative model rate compares standard, non-cached text-token rates using one fixed reference mix. It is not a credit estimate. Actual usage can vary with input and output length, cache reads and writes, long-context pricing, reasoning, files and images, chat history and memory, custom instructions or agents, tools, extra model calls, delegation, retries, parallel work, and other factors.\",\"disclaimerNote\":\"*Note:\"},\"agentModeCreditsTitle\":\"Agent Mode Credit Usage\",\"agentModeCreditsDescription\":\"Compare the Agent models currently available to you. Powerful models are best for tougher reasoning and multi-step analysis; fast, efficient models suit routine or high-volume work. Agent credits are based on actual tokens, reasoning, and tool work—not a flat per-page rate.\",\"agentExamples\":{\"taskExamplesTitle\":\"Example Agent Tasks\",\"tableHeaders\":{\"agentModel\":\"Agent Model\",\"costLevel\":\"Model tier\",\"task\":\"Task\",\"description\":\"Description\",\"estimatedCredits\":\"Est. Credits\"},\"delegateTool\":{\"task\":\"Document summarization\",\"description\":\"Read and create a comprehensive summary with key insights\",\"credits\":\"300-600\"},\"structuredExtractor\":{\"task\":\"Data extraction\",\"description\":\"Extract structured data from documents into tables or spreadsheets\",\"credits\":\"500-1,200\"},\"webResearch\":{\"task\":\"Web research\",\"description\":\"Search web sources, analyze findings, and compile a report\",\"credits\":\"400-900\"},\"documentAnalysis\":{\"task\":\"Document review\",\"description\":\"Analyze documents, identify key points, and suggest actions\",\"credits\":\"600-1,500\"},\"multiFileComparison\":{\"task\":\"Multi-file analysis\",\"description\":\"Compare and analyze multiple documents, identify patterns and differences\",\"credits\":\"800-2,000\"},\"disclaimerNote\":\"*Note:\",\"disclaimer\":\"These are estimated ranges. Actual credit usage depends on document size, complexity, model selected, and number of tool calls required.\"},\"footerFirst\":\"1.More powerful models consume additional credits, see Learn More for details.\",\"footerLast\":\"2.More powerful models are available for AI Drive Pro subscribers\"},\"welcomeProConfirmationPage\":{\"welcomeTitle\":\"Welcome to AI Drive Pro!\",\"welcomeSubtitle\":\"Your upgrade has been activated successfully.\",\"welcomeTitleTrial\":\"Welcome to Your AI Drive Pro Trial!\",\"welcomeSubtitleTrial\":\"Your 7-day free trial has been activated successfully.\",\"yourProFeatures\":\"Your Pro Features\",\"experienceFullPower\":\"Experience the full power of AI-driven document management\",\"featureCreditsTitle\":\"50,000 Credits\",\"featureCreditsTitleDynamic\":\"{credits} Credits\",\"featureCreditsSubtitle\":\"Monthly allocation\",\"featureCreditsSubtitleTrial\":\"Trial allocation\",\"featureLatestModelsTitle\":\"Latest AI Models\",\"featureLatestModelsSubtitle\":\"OpenAI, Claude, Gemini\",\"featureUnlimitedUploadTitle\":\"Unlimited Upload\",\"featureUnlimitedUploadSubtitle\":\"Batch processing enabled\",\"featureAISearchTitle\":\"AI Search\",\"featureAISearchSubtitle\":\"Advanced search capabilities\",\"featureDocumentSummarization\":\"Document summarization\",\"featureDataExtraction\":\"Data extraction\",\"featureOCR\":\"OCR (Optical Character Recognition)\",\"featureAIDriveAgent\":\"AI Drive Agent\",\"featureFolderSearch\":\"Folder Search\",\"goToAIDrivePro\":\"Go to AI Drive Pro\"},\"trialEndedPage\":{\"trialEnded\":\"Your free trial has ended\",\"headline\":\"Continue using AI Drive Pro\",\"currentPlan\":\"Current plan\",\"planNow\":\"Free\",\"monthlyCredits\":\"Monthly credits\",\"creditsNowValue\":\"{count}\",\"features\":{\"moreCredits\":\"{count} credits/month\",\"premiumModels\":\"Claude, OpenAI, Gemini Pro \u0026 more\",\"nonPdfFiles\":\"Chat with images, spreadsheets \u0026 more\",\"aiDriveAgent\":\"AI Drive Agent for complex tasks\",\"chatWithFolders\":\"Chat with entire folders\",\"dataExtraction\":\"AI data extraction \u0026 OCR\",\"unlimitedUploads\":\"Unlimited file uploads\",\"customAgents\":\"Build custom AI agents\"},\"upgradeToPro\":\"Upgrade to Pro - {price}/mo\",\"viewPlans\":\"View Plans\",\"bookCall\":\"Book a Call\",\"continueFree\":\"Continue with Free\",\"alreadySubscribed\":\"You already have an active subscription!\"},\"welcomeBusinessConfirmationPage\":{\"welcomeTitle\":\"Welcome to AI Drive Business!\",\"welcomeSubtitle\":\"Your business workspace has been activated successfully. Experience the full power of AI-optimized business workflows.\",\"ctaTitle\":\"Your Business Plan is Ready\",\"price\":\"$$200\",\"period\":\"/month\",\"featuresTitle\":\"Your Business Features\",\"featuresSubtitle\":\"Experience the full power of AI-optimized business workflows\",\"getStartedButton\":\"Go to AI Drive Business\",\"features\":{\"credits\":{\"title\":\"300,000 Credits\",\"description\":\"6x more processing power than Pro\"},\"aiAgents\":{\"title\":\"Advanced AI Agents\",\"description\":\"Email workflows and enterprise optimization\"},\"privacy\":{\"title\":\"Data Privacy\",\"description\":\"SOC 2 Type 2 examination completed\"},\"support\":{\"title\":\"Priority Support\",\"description\":\"Dedicated success manager\"}},\"featureList\":{\"allAiModels\":\"All AI models (GPT-4, Claude, Gemini)\",\"allProFileTypes\":\"All Pro file types + sound files\",\"emailIntegration\":\"Email integration with AI agents\",\"shareFiles\":\"Share files, folders \u0026 AI agents\",\"advancedSecurity\":\"Advanced security \u0026 privacy\",\"onboardingCall\":\"Onboarding call to setup your AI agents\",\"internalUsers\":\"Up to 5 internal users included\",\"noAiTraining\":\"No AI training + SOC 2 Type 2 examination completed\",\"aiDataExtraction\":\"AI data extraction and file organization\",\"chatWithFolders\":\"Chat with folders with hundreds of files\"}},\"freeTrialPage\":{\"hero\":{\"titlePrefix\":\"Start Your\",\"titleHighlight\":\"7-Day Free Trial\",\"subtitle\":\"Experience AI Drive Pro with all premium features. Available exclusively for work email addresses.\"},\"eligibility\":{\"notEligible\":\"This free trial is only for new users. Since you've subscribed before, you're not eligible for another trial.\",\"requireWorkEmail\":\"Sign up or log in with a work email to activate your trial. Personal emails are not eligible for this trial.\",\"personalEmail\":\"You're signed in with \u003cemail\u003e{email}\u003c/email\u003e. The free trial is available only for work email addresses. Please sign up with a work email.\",\"workEmail\":\"\u003cemail\u003e{email}\u003c/email\u003e is eligible for the 7-day free trial.\",\"hasSubscription\":\"You already have a subscription with all premium features.\"},\"buttons\":{\"activate\":\"Activate Free Trial\",\"activating\":\"Activating...\",\"login\":\"Log In\",\"goHome\":\"Go to Home\"},\"toasts\":{\"signInRequired\":\"Please sign in to activate your trial.\",\"success\":\"Free trial activated successfully!\",\"notEligible\":\"You are not eligible for the free trial.\",\"error\":\"Failed to activate trial. Please try again.\"},\"trustIndicators\":{\"fullAccess\":\"7 days full access\",\"allFeatures\":\"All Pro features included\",\"noCard\":\"No credit card required\"},\"loading\":\"Loading...\"},\"welcomeEnterpriseConfirmationPage\":{\"welcomeTitle\":\"Welcome to AI Drive Enterprise!\",\"welcomeSubtitle\":\"Your enterprise account has been activated successfully. Experience the highest level of security, compliance, and dedicated support.\",\"featuresTitle\":\"Your Enterprise Features\",\"featuresSubtitle\":\"Advanced privacy, auditability, and dedicated support\",\"getStartedButton\":\"Go to AI Drive Enterprise\",\"features\":{\"credits\":{\"title\":\"Custom Credits\",\"description\":\"Tailored to your organization's needs\"},\"hipaa\":{\"title\":\"HIPAA BAA\",\"description\":\"HIPAA BAA + U.S. stored-data residency\"},\"zeroRetention\":{\"title\":\"Zero Data Retention\",\"description\":\"Zero data retention options available\"},\"auditLogs\":{\"title\":\"Audit Logs\",\"description\":\"Detailed access \u0026 export audit logs\"}},\"featureList\":{\"everythingInBusiness\":\"Everything in AI Drive Business\",\"dedicatedSupport\":\"Dedicated CSM \u0026 remote implementation\",\"minimumCredits\":\"Minimum 500,000 credits/month (pooled)\",\"hipaaCompliance\":\"HIPAA BAA + U.S. stored-data residency\",\"zeroDataRetention\":\"Zero data retention options\",\"auditLogs\":\"Detailed access \u0026 export audit logs\",\"customIntegrations\":\"Custom integrations \u0026 API access\",\"sla\":\"Service level agreement (SLA)\",\"accountManager\":\"Designated account manager\",\"sso\":\"Single Sign-On (SSO) \u0026 SAML\",\"advancedAnalytics\":\"Advanced usage analytics\",\"priorityOnboarding\":\"Priority onboarding \u0026 training\",\"customCredits\":\"Custom credit packages\",\"dataResidency\":\"Stored-data residency and optional U.S.-only AI execution\"}},\"enterpriseSecurityPage\":{\"title\":\"AI Drive Enterprise Security\",\"subtitle\":\"Enterprise-grade security and compliance features designed for organizations handling sensitive documents\",\"hipaa\":{\"title\":\"HIPAA BAA \u0026 U.S. Stored-Data Residency\",\"description\":\"AI Drive Enterprise offers Business Associate Agreement (BAA) for HIPAA compliance, ensuring your healthcare-related documents meet strict regulatory requirements.\",\"usDataResidency\":{\"title\":\"U.S. Stored-Data Residency\",\"description\":\"Customer files, chat history, platform hosting, and core infrastructure are stored and operated in Google US data centers with strict access controls and continuous monitoring.\"},\"baaAgreement\":{\"title\":\"BAA Agreement\",\"description\":\"Available for organizations requiring HIPAA compliance\"},\"secureInfrastructure\":{\"title\":\"Secure Infrastructure\",\"description\":\"Enterprise-grade infrastructure with multiple layers of physical and digital security\"}},\"aiModelProtection\":{\"title\":\"AI Model Data Protection\",\"description\":\"Your data is protected at every level with strict privacy controls and AI provider agreements. AI model execution may use global provider endpoints by default, and Enterprise customers can opt in to U.S.-only execution for supported models and providers.\",\"zeroAiTraining\":{\"title\":\"Zero AI Training\",\"description\":\"AI model providers (OpenAI, Anthropic, Google, and xAI/Grok) do not use your data for model training\"},\"zeroDataRetention\":{\"title\":\"Zero Data Retention\",\"description\":\"Zero data retention is available with OpenAI, Anthropic, Google (Gemini), and xAI (Grok).\"},\"secureStorage\":{\"title\":\"Secure Storage\",\"description\":\"Your files and chat history are securely stored on AI Drive servers with enterprise-grade encryption\"},\"dataControl\":{\"title\":\"Data Control\",\"description\":\"Manage retention policies and delete your data at any time\"}},\"auditLogs\":{\"title\":\"Detailed Access \u0026 Export Audit Logs\",\"description\":\"Comprehensive audit logging ensures complete visibility into all system activities for compliance and security monitoring.\",\"accessTracking\":{\"title\":\"Access Tracking\",\"description\":\"Monitor who accessed which files and when\"},\"operationLogs\":{\"title\":\"Operation Logs\",\"description\":\"Track all operations including file access, chat history, and custom agent activities\"},\"exportableReports\":{\"title\":\"Exportable Reports\",\"description\":\"Generate detailed audit reports for compliance audits and security reviews\"}},\"securityInfrastructure\":{\"title\":\"Enterprise Security Infrastructure\",\"description\":\"All the security features from our standard platform, enhanced with enterprise-grade controls:\",\"tlsEncryption\":{\"title\":\"TLS 1.3 Encryption\",\"description\":\"All data in transit is encrypted using the latest TLS protocol\"},\"aes256\":{\"title\":\"AES-256 Encryption at Rest\",\"description\":\"Industry-standard encryption for all stored data\"},\"secureStorage\":{\"title\":\"Secure Cloud Storage\",\"description\":\"Customer files, chat history, platform hosting, and core infrastructure are stored and operated in SOC 2-compliant Google Cloud US data centers.\"},\"accessControl\":{\"title\":\"Strict Access Controls\",\"description\":\"Role-based access control and multi-factor authentication\"},\"regularAudits\":{\"title\":\"Regular Security Audits\",\"description\":\"Ongoing security assessments and penetration testing\"}},\"contact\":{\"enterpriseUser\":\"Have questions about your enterprise security features? Reach out to your account manager.\",\"prospectUser\":\"Our team is ready to discuss your organization's specific security and compliance requirements. Contact us to learn more about AI Drive Enterprise.\",\"emailAccountManager\":\"Email Account Manager\",\"bookMeeting\":\"Book a Meeting\",\"emailSalesTeam\":\"Email Sales Team\"},\"contactTitle\":\"Questions About Enterprise Security?\",\"additionalResources\":{\"intro\":\"For more information about our security practices, please review our\",\"securityPage\":\"Security Page\",\"privacyPolicy\":\"Privacy Policy\",\"termsOfService\":\"Terms of Service\",\"and\":\"and\"}},\"accountPage\":{\"title\":\"My Account\",\"backLink\":\"Go back to AI Drive\",\"loading\":\"Loading...\",\"navigation\":{\"accountDetail\":\"Account Detail\",\"manageTeams\":\"Manage Your Team\",\"userGroups\":\"User Groups\",\"costCenters\":\"Cost Centers\",\"manageApiKey\":\"Manage API Key\",\"auditLogs\":\"Audit Logs\",\"creditUsage\":\"Credit Usage\",\"modelAccess\":\"Model access\",\"securityPrivacy\":\"Security \u0026 Privacy\"},\"securityPrivacy\":{\"title\":\"Security \u0026 Privacy\",\"subtitle\":\"Control who can join your team and how content is shared\",\"domainRestrictions\":{\"title\":\"Authorized Email Domains\",\"description\":\"Restrict team invitations and external sharing (when enabled in Sharing Permissions) to email addresses belonging to the following domains.\",\"noDomains\":\"No domain restrictions — invitations are open to all email domains.\",\"addDomain\":\"Add Domain\",\"placeholder\":\"Enter domain (e.g. company.com)\",\"invalidDomain\":\"Please enter a valid domain (e.g. example.com)\",\"duplicateDomain\":\"This domain is already added\"},\"sharingPermissions\":{\"title\":\"Sharing Permissions\",\"description\":\"Control who can share files, folders, chats, and agents — and with whom. These rules apply to all content types.\",\"canShareWith\":\"can share with\",\"audiences\":{\"organization\":{\"label\":\"The whole organization\"},\"external_specific_members\":{\"label\":\"AI Drive users external to your organization (outside your authorized domains)\",\"inactiveHint\":\"Configure authorized email domains above to enforce this rule.\"},\"anyone_with_link\":{\"label\":\"Anyone on the Internet (via public link)\"}},\"permissions\":{\"everyone\":\"All members\",\"admins\":\"Admins only\",\"no_one\":\"No one\"},\"badges\":{\"everyone\":\"All members\",\"admins\":\"Admins only\",\"no_one\":\"Disabled\"}},\"browserTools\":{\"title\":\"Browser Tools\",\"description\":\"Let the AI assistant open and interact with a live browser session on behalf of your team members.\",\"label\":\"Enable browser tools\",\"hint\":\"When enabled, members can ask the assistant to navigate, click, and fill in forms on live web pages. Saved sign-in state is kept per site and shared across the team member's own chats.\",\"fileUpload\":{\"label\":\"Allow file uploads to websites\",\"hint\":\"Saving files the browser downloads into AI Drive is not controlled by this switch; it follows browser access. Turn this on to also let agents upload files from AI Drive into websites. Leave it off to keep AI Drive file contents from leaving to third-party sites.\"},\"accessNote\":\"Browser tools live under My Account → Security \u0026 Privacy → Browser Tools. Grant them to your whole organization, or to specific user groups.\",\"scopeTitle\":\"Who can use browser tools\",\"scopeDescription\":\"Choose whether every member of your organization gets browser tools, or only the members of specific user groups.\",\"scopes\":{\"everyone\":{\"label\":\"Everyone in the organization\",\"description\":\"Every member of your team can use the browser tools.\"},\"groups\":{\"label\":\"Only selected user groups\",\"description\":\"Only members of the user groups you select can use the browser tools.\"}},\"groupsLabel\":\"User groups\",\"searchGroups\":\"Search groups\",\"noGroups\":\"No user groups in your team yet.\",\"noMatches\":\"No matches.\",\"groupMemberCount\":\"{count} members\",\"removeGroup\":\"Remove {group}\",\"scopeEmptyHint\":\"Select at least one user group, or choose “Everyone in the organization”. Saving with no groups selected would take browser tools away from every member.\"},\"sharingRestricted\":\"Sharing is restricted by your team's security policy. Contact a team admin to change this setting.\",\"save\":\"Save Changes\",\"saving\":\"Saving...\",\"discard\":\"Discard\",\"saveSuccess\":\"Security settings saved\",\"saveError\":\"Failed to save security settings\",\"refetchError\":\"Saved, but couldn't reload latest settings. Refresh to see the 