eep first.\",\"button\":\"Delete Account\",\"message\":\"This action is irreversible\",\"label\":\"Confirm your account email to proceed\",\"optionTitle\":\"Help us get better answering why:\",\"options\":{\"option1\":\"It doesn't have the features I need\",\"option2\":\"I found something better\",\"option3\":\"I no longer need it\",\"option4\":\"Other\"},\"placeholder\":{\"first\":\"What feature is missing? (optional)\",\"second\":\"Which product do you prefer instead of AI PDF and why? (optional)\",\"fourth\":\"Please provide more details (optional)\"},\"emailError\":\"This email does not match the email associated with your account.\",\"deletionInProgress\":{\"title\":\"Deleting your account...\",\"description\":\"This may take a few minutes for accounts with many files. You can leave this page; deletion will continue in the background.\",\"continueButton\":\"Continue to Homepage\"},\"deletionFailed\":{\"title\":\"Account Deletion Failed\",\"defaultError\":\"An unexpected error occurred.\",\"contactSupport\":\"If this problem persists, please contact support.\",\"closeButton\":\"Close\",\"retryButton\":\"Try Again\"},\"deletionToast\":{\"inProgress\":\"Account deletion in progress. You have been logged out.\",\"success\":\"Account deleted successfully\"},\"deletionErrors\":{\"timeout\":\"Deletion is taking longer than expected. Please check back later or contact support.\",\"failed\":\"Account deletion failed. Please try again later.\",\"startFailed\":\"Failed to start account deletion. Please try again later.\",\"teamAdmin\":\"You are not allowed to delete your account as a team admin.\",\"teamAdminDescription\":\"Please delete your team first in order to proceed with account deletion.\"}}},\"subscriptions\":{\"title\":\"Subscriptions\",\"activePlan\":\"Active plan\",\"manage\":{\"title\":\"Manage subscription\",\"info\":\"Please don't change the email address in your Stripe's account. Contact us (help@myaidrive.com) if you need to change your email.\",\"button\