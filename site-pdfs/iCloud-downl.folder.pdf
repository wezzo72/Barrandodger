\",\"title\":\"Teams Management\",\"deleteTeam\":\"Delete your team\",\"description\":\"Description\",\"members\":\"members\",\"billedSeat\":\"billed seats\",\"seatLimitInlineTitle\":\"Seat limit reached\",\"seatLimitInlineDescription\":\"This workspace includes {count} seats by default. Contact sales to add more users.\",\"seatLimitInlineAction\":\"Contact sales\",\"seatLimitModalTitle\":\"Add more seats\",\"seatLimitModalDescription\":\"Your team has reached its included Business seats. Our sales team can raise the limit for your workspace.\",\"seatLimitModalUsage\":\"{members} of {limit} seats used\",\"seatLimitBookSalesCall\":\"Book a sales call\",\"seatLimitContinueManaging\":\"Maybe later\",\"seatLimitToast\":\"Your team has reached its seat limit. Contact sales to add more users.\",\"totalCredits\":\"Total Credits\",\"consumed\":\"Consumed\",\"teamMembers\":\"Team Members\",\"searchPlaceholder\":\"Search by email, role, or tier...\",\"searchResults\":\"Showing {count} of {total} members\",\"noSearchResults\":\"No members match your search\",\"noMembers\":\"No team members\",\"clearSearch\":\"Clear search\",\"cancel\":\"Cancel\",\"addMember\":\"Add Member\",\"editMember\":\"Edit Member\",\"addMemberHeader\":\"Add New Member\",\"editMemberHeader\":\"Edit Member\",\"confirmRemoval\":\"Confirm Removal\",\"edit\":\"Edit\",\"remove\":\"Remove\",\"deleteTeamGuide\":\"Deleting a team removes members’ team access and team sharing, but keeps their accounts and files. It does not cancel the team subscription. To stop billing, cancel the subscription separately under Manage subscription in \u003caccountLink\u003eAccount details\u003c/accountLink\u003e. Choose Delete your team below, then type the team name to confirm.\",\"deleteTeamInfo\":\"\u003clink\u003e{link}\u003c/link\u003e\",\"deleteTeamModal\":{\"title\":\"Delete {teamName}?\",\"permanentWarning\":\"This action is permanent and cannot be undone.\",\"consequencesIntro\":\"Deleting this team means:\",\"consequenceMembers\":\"All team members immediately lose access to the team, including any team plan benefits such as team AI model access and shared credits.\",\"consequenceSharing\":\"Files and folders shared with the team stop being shared, and team members lose access to them. The files themselves are not deleted from their owners' drives.\",\"consequenceGroups\":\"All team groups and group-based sharing are permanently removed.\",\"consequenceInvitations\":\"Pending team invitations will no longer work.\",\"consequenceSubscription\":\"Your team subscription is not cancelled automatically. Manage or cancel it separately in your billing settings.\",\"contactHelp\":\"If you are unsure or would like more information about what your team could lose, please contact \u003clink\u003ehelp@myaidrive.com\u003c/link\u003e before deleting your team.\",\"typeToConfirm\":\"To confirm, type \u003cstrong\u003e{teamName}\u003c/strong\u003e below:\",\"deleteTeamConfirm\":\"Delete team\"},\"teamNameInput\":\"Team Name\",\"enterTeamName\":\"Enter team name\",\"teamDescriptionInput\":\"Team Description\",\"enterTeamDescription\":\"Enter team description\",\"emailPlaceholder\":\"Enter email address\",\"emailInput\":\"Email Address\",\"roleSelect\":\"Select Role\",\"accessTierSelect\":\"Select Access Tier\",\"tableHeader\":{\"email\":\"EMAIL\",\"role\":\"ROLE\",\"joined\":\"JOINED\",\"actions\":\"ACTIONS\",\"usage\":\"USAGE\",\"sentDate\":\"Sent Date\",\"expires\":\"Expires\",\"status\":\"Status\",\"accessTier\":\"ACCESS TIER\"},\"roles\":{\"member\":\"Member\",\"admin\":\"Admin\"},\"accessTiers\":{\"power\":\"⚡ Power\",\"standard\":\"Standard\"},\"bulkActions\":{\"selected\":\"{count, plural, one {# member selected} other {# members selected}}\",\"changeRole\":\"Change role\",\"changeTier\":\"Change tier\",\"clearSelection\":\"Clear\",\"bulkChangeSuccess\":\"Updated {count, plural, one {# member} other {# members}} successfully\",\"bulkChangePartialSuccess\":\"Updated {success} of {total} member